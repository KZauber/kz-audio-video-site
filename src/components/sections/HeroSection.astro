---
interface Props {
  overline?: string;
  heading: string;
  subhead: string;
  ctaLabel?: string;
  ctaHref?: string;
  secondaryCta?: string;
  secondaryHref?: string;
  imageSrc: string;
  imageAlt: string;
  videoSrc?: string;
  align?: 'left' | 'center';
  /** Pass true to shrink the H1 for pages where the default hero size is too large */
  compact?: boolean;
  /** Pass true to use a lighter gradient overlay */
  lightGradient?: boolean;
  /** Tailwind object-position class for the background image, e.g. 'object-top', 'object-center', 'object-bottom' */
  imagePosition?: string;
  /** Push the image down by this many pixels so top content is visible */
  imagePushDown?: number;
  /** Override the minimum height, e.g. 'min-h-[70vh]'. Defaults to 'min-h-screen' */
  minHeight?: string;
}

const {
  overline,
  heading,
  subhead,
  ctaLabel,
  ctaHref  = '/contact-kz-audio-video-san-antonio-tx/',
  secondaryCta,
  secondaryHref = 'tel:2109814098',
  imageSrc,
  imageAlt,
  videoSrc,
  align = 'left',
  compact = false,
  lightGradient = false,
  imagePosition = 'object-top',
  imagePushDown = 0,
  minHeight = 'min-h-[72vh] md:min-h-screen',
} = Astro.props;
---

<section class:list={["relative w-full flex items-center md:items-end overflow-hidden", minHeight]} style="background:#0E1012;">

  <!-- Full-bleed background: video (when provided) or image fallback -->
  <div class="absolute inset-0 hero-enter-img" style={`transform: translateY(${imagePushDown}px);`} aria-hidden="true">

    {videoSrc ? (
      /* ── VIDEO BACKGROUND (desktop only) ────────────────────────────────
         Phones get the still poster below instead of the multi-MB video,
         which keeps the mobile page light and the hero fast on cellular.
         autoplay muted loop playsinline are required for browser autoplay. */
      <>
        <img
          src={imageSrc}
          alt=""
          aria-hidden="true"
          class={`w-full h-full object-cover md:hidden ${imagePosition}`}
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
        <video
          class="w-full h-full object-cover object-center hidden md:block"
          muted
          loop
          playsinline
          aria-hidden="true"
          preload="none"
          data-hero-video
          data-src={videoSrc}
        >
          {/* Fallback: show poster image if video fails */}
          <img src={imageSrc} alt="" aria-hidden="true" class="w-full h-full object-cover" />
        </video>
        <script is:inline>
          /* Load the hero video only on desktop widths. On phones the source is
             never set, so the multi-MB file is never downloaded. The still
             poster carries the mobile hero. */
          (function () {
            var v = document.querySelector('[data-hero-video]');
            if (v && window.matchMedia('(min-width: 768px)').matches) {
              var s = document.createElement('source');
              s.src = v.getAttribute('data-src');
              s.type = 'video/mp4';
              v.appendChild(s);
              v.load();
              var p = v.play();
              if (p && p.catch) p.catch(function () {});
            }
          })();
        </script>
      </>
    ) : (
      /* ── IMAGE BACKGROUND (location pages + any page without video) ─── */
      <img
        src={imageSrc}
        alt=""
        aria-hidden="true"
        class={`w-full h-full object-cover ${imagePosition}`}
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    )}

    <!-- Cinematic vignette: left + bottom darkening -->
    <div
      class="absolute inset-0"
      style={lightGradient
        ? `background:
            linear-gradient(to right, rgba(14,16,18,0.45) 0%, rgba(14,16,18,0.18) 30%, rgba(14,16,18,0.02) 52%, rgba(14,16,18,0.00) 100%),
            linear-gradient(to top, rgba(14,16,18,0.28) 0%, rgba(14,16,18,0.06) 25%, transparent 50%),
            linear-gradient(to bottom, rgba(14,16,18,0.08) 0%, transparent 12%)`
        : `background:
            linear-gradient(to right, rgba(14,16,18,0.68) 0%, rgba(14,16,18,0.28) 30%, rgba(14,16,18,0.04) 52%, rgba(14,16,18,0.00) 100%),
            linear-gradient(to top, rgba(14,16,18,0.48) 0%, rgba(14,16,18,0.10) 25%, transparent 50%),
            linear-gradient(to bottom, rgba(14,16,18,0.14) 0%, transparent 12%)`}
      aria-hidden="true"
    ></div>
    <!-- Subtle gold atmosphere at bottom-left -->
    <div
      class="absolute bottom-0 left-0 w-[500px] h-[280px] pointer-events-none"
      style="background: radial-gradient(ellipse at 0% 100%, rgba(201,168,76,0.07) 0%, transparent 70%)"
      aria-hidden="true"
    ></div>
  </div>

  <!-- Content — anchored to bottom for cinematic feel -->
  <div class="relative z-10 w-full container-wide px-6 sm:px-8 lg:px-12 pt-20 pb-16 md:pt-40 md:pb-28">
    <div class:list={[
      'max-w-[330px] sm:max-w-sm lg:max-w-md',
      align === 'center' ? 'mx-auto text-center' : '',
    ]}>

      {overline && (
        <p class="overline mb-4 md:mb-6 hero-enter-1 flex items-center gap-3" style="letter-spacing:0.18em;">
          <span class="block w-10 h-px opacity-70" style="background:linear-gradient(90deg,#C9A84C,transparent);"></span>
          {overline}
        </p>
      )}

      <h1
        class:list={[
          'font-display text-warm-white hero-enter-2 leading-[1.15] md:leading-[1.04]',
          compact ? 'text-xl md:text-h1' : 'text-xl md:text-hero',
        ]}
        style="letter-spacing:-0.02em;"
      >
        {heading}
      </h1>

      <p class="text-body-sm text-stone mb-5 md:mb-10 max-w-lg hero-enter-3 md:text-body-lg" style="line-height:1.7;">
        {subhead}
      </p>

      {ctaLabel && (
        <div class:list={[
          'flex flex-col sm:flex-row sm:flex-wrap gap-4 hero-enter-4',
          align === 'center' ? 'justify-center' : '',
        ]}>
          <a href={ctaHref} class="btn-primary gold-shimmer shrink-0">
            {ctaLabel}
          </a>
          {secondaryCta && (
            <a href={secondaryHref} class="btn-ghost shrink-0">
              {secondaryCta}
            </a>
          )}
        </div>
      )}

    </div>
  </div>

</section>
