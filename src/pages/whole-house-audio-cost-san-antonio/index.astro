---
import BaseLayout from "../../layouts/BaseLayout.astro";
import HeroSection from "../../components/sections/HeroSection.astro";
import TrustBar from "../../components/sections/TrustBar.astro";
import CTASection from "../../components/sections/CTASection.astro";

const schema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Whole-House Audio Cost: San Antonio TX",
  "provider": {
    "@type": "LocalBusiness",
    "name": "KZ Audio & Video",
    "url": "https://kzaudioandvideo.com",
    "telephone": "+12109814098",
  },
  "areaServed": ["San Antonio", "Boerne", "Canyon Lake", "Helotes", "Bulverde", "Stone Oak", "New Braunfels", "Schertz", "Seguin"],
  "description": "What whole-house audio and multi-room music systems cost in San Antonio TX. Real price ranges by zone count, an instant estimate calculator, and answers to common cost questions.",
  "url": "https://kzaudioandvideo.com/whole-house-audio-cost-san-antonio/",
  "offers": {
    "@type": "AggregateOffer",
    "priceCurrency": "USD",
    "lowPrice": "6000",
    "highPrice": "40000",
    "offerCount": "4",
  },
};

const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://kzaudioandvideo.com" },
    { "@type": "ListItem", "position": 2, "name": "Whole-House Audio Cost San Antonio" },
  ],
};

const costFaqs = [
  {
    question: "How much does whole-house audio cost in San Antonio?",
    answer:
      "Whole-house audio in San Antonio runs about $1,900 per zone at retail, so the total comes down to how many rooms you want covered. Each zone includes a Sonos amplifier, a pair of quality in-ceiling speakers, the wiring, and the install and programming. As a rough guide, three zones (say a living room, kitchen, and patio) run around $5,700, five zones around $9,500, and eight zones around $15,200. Premium architectural speakers, outdoor zones, and a dedicated control system like RTI add cost on top. Each zone is controlled independently from your phone. KZ Audio & Video designs the layout around how you actually live in the home.",
  },
  {
    question: "How much does whole-house audio cost per room or zone?",
    answer:
      "As a planning number, a whole-house audio zone in San Antonio costs about $1,900 per room at retail, fully installed. That covers a Sonos amplifier, a pair of quality in-ceiling speakers, the wiring, and the labor to install, set up, and calibrate. Because each zone runs on its own amp, the cost scales per room rather than dropping off: five rooms is about five times one room. Outdoor zones and zones with premium architectural speakers run higher. We size the system for the total number of rooms so it performs evenly and has room to grow.",
  },
  {
    question: "Is Sonos cheaper than a wired whole-house audio system?",
    answer:
      "For a few rooms, Sonos and similar wireless systems are usually cheaper and simpler, each powered speaker plugs in and connects over Wi-Fi, with no wiring to run. For two or three rooms, that is often the smart, cost-effective choice. But as you scale to a whole home, a wired, centrally-amplified system frequently makes more sense: it sounds better with in-ceiling architectural speakers, hides completely, has no powered boxes on shelves, and is more reliable across many zones than a Wi-Fi mesh. Wired systems also integrate cleanly with home control or RTI for one-touch whole-home control. We install both, and we recommend based on your home size, how many zones you want, and whether you value the clean built-in look. For a true whole-house system, wired is usually the better long-term value.",
  },
  {
    question: "How much does a home control or RTI control system add to whole-house audio?",
    answer:
      "Adding a dedicated control system like home control or RTI to a whole-house audio setup typically adds $4,000 to $12,000, depending on home size and how much you integrate. That covers the controller hardware, programming, and interfaces: wall keypads, touchscreens, and phone apps. The value is unified control: one tap plays the same music everywhere for a party, or different music in each zone, and the same system can fold in lighting, shades, and your home theater. App-only platforms like Sonos cost nothing extra for control but stay siloed to audio. For a starter two or three-zone system, app-based control usually makes sense. For a larger home where you want audio, video, lighting, and climate on one reliable interface, a dealer-programmed home control or RTI system is worth the investment. We program it around your routines.",
  },
  {
    question: "Can I add whole-house audio to an existing home, and what does retrofit cost?",
    answer:
      "Yes, we retrofit whole-house audio into finished San Antonio homes regularly. The added cost over new construction comes from fishing speaker wire through closed walls, ceilings, and attic spaces instead of running it through open framing, plus patching and finishing. Expect retrofit to add roughly $1,500 to $6,000 over the same system in new construction, depending on home layout, attic access, and the number of zones. Single-story homes with good attic access are easier and cheaper than two-story homes where wire has to be fished down interior walls. Wireless systems like Sonos avoid the wiring entirely but trade off the clean in-ceiling look. We walk the home, check the access points, and tell you exactly what the retrofit involves before quoting, no surprises once we start.",
  },
  {
    question: "How much does it cost to add outdoor speakers to a whole-house audio system?",
    answer:
      "Adding an outdoor zone to a whole-house audio system in San Antonio typically costs $1,500 to $10,000, depending on coverage. A single patio zone with a pair of weather-rated speakers runs about $1,500 to $4,000. A larger setup covering a patio and pool area with multiple landscape or rock speakers and a buried subwoofer runs $4,000 to $10,000. Outdoor speakers cost more than indoor equivalents because they must withstand Texas heat, humidity, and sun, and the wiring has to be rated for outdoor and buried runs. The outdoor zone ties into the same control system as the rest of the house, so the same music can play inside and out, or the patio can run independently. Given how much of the year is patio season here, outdoor zones are one of our most popular additions.",
  },
  {
    question: "What is the cheapest way to get multi-room audio?",
    answer:
      "The most affordable entry into multi-room audio is a wireless app-based system using powered speakers: Sonos is the common example. You can start with one or two rooms and add more over time, with simple phone control. Professionally installed, a clean two or three-room setup runs about $3,800 to $5,700. It is the budget-friendly path when you want music in a few rooms. The tradeoff is visible powered speakers on shelves instead of the clean in-ceiling look, and reliance on Wi-Fi. If you only want a few rooms and value simplicity over a built-in install, this is a solid choice, and we are happy to set it up properly.",
  },
  {
    question: "Why does whole-house audio cost vary so much?",
    answer:
      "Whole-house audio quotes range widely because the term covers a two-room wireless setup and a twelve-zone integrated system in a custom home. The biggest driver is zone count: each room adds speakers, wiring, and an amplifier channel. Speaker quality matters too: standard in-ceiling speakers cost a fraction of architectural or high-end models. The control platform is a major swing, from free app-based control to a dealer-programmed home control system. Outdoor zones, music servers, and whole-home integration with lighting and video all add cost. Finally, retrofit into a finished home costs more in labor than pre-wiring during construction. A vague online number means little without knowing your home and how many zones you want. That is why we walk the home, count the zones, and give you a written scope and price you can rely on.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": costFaqs.map((f) => ({
    "@type": "Question",
    "name": f.question,
    "acceptedAnswer": { "@type": "Answer", "text": f.answer },
  })),
};

const calcGroups = [
  {
    id: "zones",
    label: "1. How many zones (rooms / areas)?",
    options: [
      { t: "2-3 zones (starter)", min: 3800, max: 5700, on: true },
      { t: "4-5 zones", min: 7600, max: 9500 },
      { t: "6-7 zones", min: 11400, max: 13300 },
      { t: "8+ zones (whole home)", min: 15200, max: 19000 },
    ],
  },
  {
    id: "speakers",
    label: "2. Speaker quality?",
    options: [
      { t: "Standard in-ceiling", min: 0, max: 0, on: true },
      { t: "Premium in-ceiling / in-wall", min: 1000, max: 3000 },
      { t: "Architectural / high-end", min: 3000, max: 6000 },
    ],
  },
  {
    id: "control",
    label: "3. Control platform?",
    options: [
      { t: "App-based (e.g. Sonos)", min: 0, max: 0, on: true },
      { t: "Keypads + app", min: 1000, max: 3000 },
      { t: "home control / RTI integrated", min: 4000, max: 12000 },
    ],
  },
  {
    id: "outdoor",
    label: "4. Outdoor zones?",
    options: [
      { t: "None", min: 0, max: 0, on: true },
      { t: "Patio / pool zone", min: 1500, max: 5000 },
      { t: "Full outdoor (multi-zone yard)", min: 4000, max: 10000 },
    ],
  },
  {
    id: "sources",
    label: "5. Streaming & sources?",
    options: [
      { t: "Use streaming apps", min: 0, max: 0, on: true },
      { t: "Dedicated streamers per zone", min: 800, max: 3000 },
      { t: "Whole-home music server", min: 2000, max: 6000 },
    ],
  },
  {
    id: "wiring",
    label: "6. Your home is…",
    options: [
      { t: "New construction (pre-wire)", min: 0, max: 0, on: true },
      { t: "Existing finished home (retrofit)", min: 1500, max: 6000 },
    ],
  },
  {
    id: "keypads",
    label: "7. In-room control?",
    options: [
      { t: "App only", min: 0, max: 0, on: true },
      { t: "Add wall keypads", min: 800, max: 3000 },
    ],
  },
];
---

<BaseLayout
  title="Whole-House Audio Cost San Antonio TX | KZ Audio & Video"
  description="What does whole-house audio cost in San Antonio? About $1,900 per zone, real price ranges by room count, and an instant estimate. Call (210) 981-4098."
  schema={[schema, breadcrumb, faqSchema]}
>
  <HeroSection
    heading="How Much Does Whole-House Audio Cost in San Antonio?"
    subhead="Real prices by zone count, an instant estimate calculator, and straight answers on Sonos vs wired, control systems, and retrofit costs."
    imageSrc="/images/projects/hill-country-outdoor-av-pool/hill-country-outdoor-av-pool-hero.jpg"
    imageAlt="Whole-house and outdoor audio system at a San Antonio Hill Country home"
    compact={true}
  />

  <TrustBar />

  <section class="section bg-slate-surface">
    <div class="container-main">
      <p class="overline mb-3">San Antonio Whole-House Audio Pricing</p>
      <h2 class="font-display text-h2 text-warm-white mb-6">
        It Comes Down to How Many Zones
      </h2>
      <p class="text-body-lg text-stone mb-4 max-w-3xl">
        Whole-house audio is priced by zones: each room or area you want music in adds speakers, wiring, and an amplifier channel. A few rooms is a modest project; a fully wired custom home is a serious system. The control platform and speaker quality move the number too.
      </p>
      <p class="text-body text-stone max-w-3xl">
        We design and install multi-room audio across San Antonio and the Hill Country, wired and wireless. Use the calculator for an instant ballpark, then read the honest cost answers below. When you want a real number, we walk the home, count the zones, and hand you a written quote, free, no obligation.
      </p>
    </div>
  </section>

  <section class="section bg-charcoal">
    <div class="container-main">
      <p class="overline mb-3">Instant Estimate</p>
      <h2 class="font-display text-h2 text-warm-white mb-4">
        Build Your Whole-House Audio Estimate
      </h2>
      <p class="text-body-lg text-stone mb-10 max-w-2xl">
        Pick what fits your home. Your estimated range updates as you go, a ballpark for the San Antonio market. Your written quote comes after a free in-home consultation.
      </p>

      <div class="grid grid-cols-1 lg:grid-cols-[1fr_360px] gap-8 items-start">
        <div class="flex flex-col gap-7" id="calc-form">
          {calcGroups.map((group) => (
            <div class="calc-group" data-group={group.id}>
              <h3 class="font-sans font-semibold text-body-lg text-warm-white mb-3">{group.label}</h3>
              <div class="flex flex-wrap gap-2.5">
                {group.options.map((opt) => (
                  <button
                    type="button"
                    class:list={["calc-opt", opt.on ? "is-active" : ""]}
                    data-min={opt.min}
                    data-max={opt.max}
                  >
                    {opt.t}
                  </button>
                ))}
              </div>
            </div>
          ))}
        </div>

        <div class="card p-7 lg:sticky lg:top-28">
          <p class="overline mb-2">Your Estimated Range</p>
          <p class="font-display text-h2 text-gold mb-1" id="calc-result">$3,800 to $5,700</p>
          <p class="text-body-sm text-ash mb-6">Estimate for the San Antonio market. Final price depends on zone count, speakers, and your home.</p>
          <a href="/contact-kz-audio-video-san-antonio-tx/" class="btn-primary gold-shimmer w-full text-center mb-3 cursor-pointer">
            Get My Exact Quote
          </a>
          <a href="tel:2109814098" class="btn-ghost w-full text-center cursor-pointer">
            Call (210) 981-4098
          </a>
          <p class="text-body-sm text-stone mt-5 leading-relaxed">
            We walk the home, count the zones, and give you a written quote, at no charge.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-slate-surface">
    <div class="container-main">
      <p class="overline mb-3">Cost Questions, Answered</p>
      <h2 class="font-display text-h2 text-warm-white mb-12">
        San Antonio Whole-House Audio Cost: FAQ
      </h2>

      <div class="flex flex-col gap-10 max-w-3xl">
        {costFaqs.map((f) => (
          <article class="reveal">
            <h2 class="font-sans font-semibold text-h3 text-warm-white mb-4">{f.question}</h2>
            <p class="text-body text-stone leading-relaxed">{f.answer}</p>
          </article>
        ))}
      </div>

      <div class="mt-12 flex flex-wrap gap-4">
        <a href="/whole-house-audio-san-antonio/" class="inline-flex items-center gap-2 text-gold font-sans font-medium cursor-pointer hover:text-warm-white transition-colors">
          See our whole-house audio service
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
        <a href="/outdoor-tv-audio-cost-san-antonio/" class="inline-flex items-center gap-2 text-gold font-sans font-medium cursor-pointer hover:text-warm-white transition-colors">
          See outdoor TV & audio costs
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </section>

  <CTASection
    heading="Get a Real Number for Your Home."
    body="The calculator gives you a ballpark. A free in-home consultation gives you the truth. We walk the home, map the zones, and put a written quote in your hands. No pressure, no obligation."
    ctaLabel="Book a Free Consultation"
    ctaHref="/contact-kz-audio-video-san-antonio-tx/"
    secondaryLabel="Call (210) 981-4098"
    secondaryHref="tel:2109814098"
    bgImage="/images/projects/monty-theater/Home-Theater-Design-Build-Near-San-Antonio-Texas.jpeg.jpg"
  />

  <style>
    .calc-opt {
      border: 1px solid rgba(255, 255, 255, 0.14);
      background: rgba(255, 255, 255, 0.03);
      color: #C9CCD1;
      border-radius: 10px;
      padding: 0.6rem 0.95rem;
      font-size: 0.9rem;
      font-family: inherit;
      cursor: pointer;
      transition: all 0.16s ease;
      line-height: 1.2;
    }
    .calc-opt:hover { border-color: rgba(201, 168, 76, 0.5); color: #F5F3EE; }
    .calc-opt.is-active {
      border-color: #C9A84C;
      background: rgba(201, 168, 76, 0.14);
      color: #F5F3EE;
      box-shadow: 0 0 0 1px rgba(201, 168, 76, 0.4);
    }
  </style>

  <script is:inline>
    (function () {
      function format(n) { return "$" + Math.round(n).toLocaleString("en-US"); }
      function recalc() {
        var total = 0, top = 0;
        var active = document.querySelectorAll(".calc-opt.is-active");
        for (var i = 0; i < active.length; i++) {
          total += parseInt(active[i].getAttribute("data-min"), 10) || 0;
          top += parseInt(active[i].getAttribute("data-max"), 10) || 0;
        }
        var out = document.getElementById("calc-result");
        if (out) out.textContent = format(total) + " – " + format(top);
      }
      var groups = document.querySelectorAll(".calc-group");
      for (var g = 0; g < groups.length; g++) {
        var opts = groups[g].querySelectorAll(".calc-opt");
        for (var o = 0; o < opts.length; o++) {
          opts[o].addEventListener("click", function () {
            var parent = this.closest(".calc-group");
            var siblings = parent.querySelectorAll(".calc-opt");
            for (var s = 0; s < siblings.length; s++) siblings[s].classList.remove("is-active");
            this.classList.add("is-active");
            recalc();
          });
        }
      }
      recalc();
    })();
  </script>
</BaseLayout>
