      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
        <div>
          <p class="overline mb-3">Avoid These</p>
          <h2 class="font-display text-h2 text-warm-white mb-6">The Home Theater Mistakes We See Most Often</h2>
          <ol class="flex flex-col gap-4 list-decimal pl-5">
            {mistakes.map(([t, d]) => (
