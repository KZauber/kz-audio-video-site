---
import BaseLayout from '../../layouts/BaseLayout.astro';

const schema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Privacy Policy: KZ Audio & Video",
  "url": "https://kzaudioandvideo.com/privacy/"
};
---

<BaseLayout
  title="Privacy Policy | KZ Audio & Video"
  description="KZ Audio & Video privacy policy. How we collect, use, and protect your information, including SMS, text, and mobile data practices here in San Antonio TX."
  schema={schema}
>
  <section class="section bg-charcoal pt-32">
    <div class="container-content">
      <p class="overline mb-3">Privacy Policy</p>
      <h1 class="font-display text-h1 text-warm-white mb-4">Privacy Policy</h1>
      <p class="text-body text-stone mb-12">Last updated: June 17, 2026</p>

      <div class="flex flex-col gap-10">

        <div>
          <p class="text-body text-stone leading-relaxed">
            KZ Audio &amp; Video ("we," "us," "our") respects your privacy. This policy explains what
            information we collect when you contact us or use kzaudioandvideo.com, how we use it, and
            the choices you have.
          </p>
        </div>

        <div>
          <h2 class="font-sans font-semibold text-h3 text-warm-white mb-3">Information We Collect</h2>
          <p class="text-body text-stone leading-relaxed">
            When you submit a form, call, or text us, we collect the information you provide, your name,
            phone number, email address, and details about your project. We also collect standard analytics
            data (such as pages visited and general location) to understand how our site is used.
          </p>
        </div>

        <div>
          <h2 class="font-sans font-semibold text-h3 text-warm-white mb-3">How We Use Your Information</h2>
          <p class="text-body text-stone leading-relaxed">
            We use your information to respond to your inquiry, schedule consultations, provide quotes and
            services, and follow up about your project. We do not sell your personal information.
          </p>
        </div>

        <div>
          <h2 class="font-sans font-semibold text-h3 text-warm-white mb-3">SMS &amp; Text Messaging</h2>
          <p class="text-body text-stone leading-relaxed mb-4">
            By submitting a form on this site or otherwise providing your phone number, you agree to receive
            calls, text messages, and emails from KZ Audio &amp; Video related to your inquiry and project.
            Message and data rates may apply, and message frequency varies. You can opt out of text messages
            at any time by replying <strong class="text-warm-white">STOP</strong>, or reply
            <strong class="text-warm-white">HELP</strong> for assistance. Consent to receive messages is not
            a condition of any purchase.
          </p>
          <p class="text-body text-stone leading-relaxed">
            <strong class="text-warm-white">No mobile information will be shared with third parties or
            affiliates for marketing or promotional purposes.</strong> Information sharing with subcontractors
            who support our services (such as scheduling or customer service providers) is permitted solely to
            help us serve you. Text messaging originator opt-in data and consent are never shared with any
            third parties for any other purpose.
          </p>
        </div>

        <div>
          <h2 class="font-sans font-semibold text-h3 text-warm-white mb-3">Cookies &amp; Analytics</h2>
          <p class="text-body text-stone leading-relaxed">
            We use cookies and analytics tools (such as Google Analytics) to understand site traffic and
            improve our website. You can disable cookies in your browser settings.
          </p>
        </div>

        <div>
          <h2 class="font-sans font-semibold text-h3 text-warm-white mb-3">Your Choices</h2>
          <p class="text-body text-stone leading-relaxed">
            You may request that we update or delete your information, or stop contacting you, at any time by
            emailing or calling us using the details below. To stop text messages, reply STOP to any message.
          </p>
        </div>

        <div>
          <h2 class="font-sans font-semibold text-h3 text-warm-white mb-3">Contact Us</h2>
          <p class="text-body text-stone leading-relaxed">
            KZ Audio &amp; Video<br />
            614 C South Business 35, New Braunfels, TX 78130<br />
            Phone: <a href="tel:2109814098" class="text-gold hover:text-gold-light">(210) 981-4098</a><br />
            Email: <a href="mailto:kelly@kzaudioandvideo.com" class="text-gold hover:text-gold-light">kelly@kzaudioandvideo.com</a>
          </p>
        </div>

      </div>
    </div>
  </section>
</BaseLayout>
