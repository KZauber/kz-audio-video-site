---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroSection from '../../components/sections/HeroSection.astro';
import TrustBar from '../../components/sections/TrustBar.astro';
import TestimonialsSection from '../../components/sections/TestimonialsSection.astro';
import FAQAccordion from '../../components/sections/FAQAccordion.astro';
import CTASection from '../../components/sections/CTASection.astro';

// KZ fixes setups, not equipment (Kelly, 2026-10-27). Never promise to repair a TV or other device here.
const schema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "AV Repair and Service: Setups, Not Devices",
  "provider": {
    "@type": "LocalBusiness",
    "name": "KZ Audio & Video",
    "url": "https://kzaudioandvideo.com",
    "telephone": "+12109814098"
  },
  "areaServed": "San Antonio, TX",
  "description": "AV service in San Antonio TX for systems that stopped working because of the setup: wiring, connections and settings a cable or internet company or another installer left not working, including systems KZ did not install. KZ fixes setups and does not repair TVs, receivers, projectors or other devices.",
  "url": "https://kzaudioandvideo.com/av-repair-san-antonio-tx/"
};

const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://kzaudioandvideo.com" },
    { "@type": "ListItem", "position": 2, "name": "AV Repair San Antonio TX" }
  ]
};

const faqs = [
  {
    question: 'Do you work on systems you didn\'t install?',
    answer: 'Yes, when the problem is the setup. One homeowner called after a cable company visit left the AV system not working. We came out and got it working again. That is the kind of job we take: wiring, connections and settings that someone else left wrong. We do not repair TVs, receivers or other devices.',
  },
  {
    question: 'What kinds of problems do you fix?',
    answer: 'Setup problems. No picture or no sound because a connection or setting is wrong, HDMI handshake failures, 4K or Dolby Atmos not coming through, surround speakers wired wrong, remotes that stopped controlling the system, cameras that went offline, Wi-Fi that drops, music that stopped playing in some rooms, and cabling that was never run right. If the cause turns out to be one device that has failed, we tell you that plainly and point you to its maker.',
  },
  {
    question: 'My home theater was installed by someone else. Can you help?',
    answer: 'Yes. We see systems from installers who stopped answering, and systems homeowners inherited when they bought the house. One homeowner\'s AV installer walked away and left the cameras and other systems in the house not working. We got them working. We work out what is installed and how it is wired, fix the setup, and tell you plainly what is worth keeping.',
  },
  {
    question: 'How do I know if my equipment can be repaired or needs to be replaced?',
    answer: 'We don\'t repair equipment, so the first question is whether the problem is the setup or the device. If the whole system or several rooms stopped working, or it broke after someone worked on it, that points to the setup, and that is our job. If one TV or receiver stopped working on its own and nothing else changed, take it to the maker\'s warranty or support line. If you decide to replace it, we can install the new one.',
  },
  {
    question: 'Do you do in-home service calls?',
    answer: 'Yes. We come to you. Setup problems live in the house: the wiring, the connections between components, and how everything is set. They have to be fixed where the system is, so we never ask you to bring equipment to us.',
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(({ question, answer }) => ({
    "@type": "Question",
    "name": question,
    "acceptedAnswer": { "@type": "Answer", "text": answer }
  }))
};

const featured = {
  name: 'San Antonio Homeowner',
  location: 'San Antonio, TX',
  service: 'Home Theater Client: Nearly 10 Years',
  quote: "Kelly and crew have always been great to work with. They're honest and will recommend what actually works for your situation rather than upselling you on equipment you don't need.",
};
---

<BaseLayout
  title="AV Repair San Antonio TX | KZ Audio & Video"
  description="AV repair in San Antonio TX for the setup, not the device: wiring, connections and settings a cable company or installer left broken. Call (210) 981-4098."
  schema={[schema, breadcrumb, faqSchema]}
>

  <HeroSection
    overline="Setups, Not Devices · Since 1999"
    heading="AV Repair and Home Theater Service in San Antonio TX"
    subhead="System stopped working after the cable company came out, or after your installer stopped answering? We fix the setup: the wiring, the connections and the settings. KZ Audio & Video has installed and fixed AV systems in San Antonio since 1999. We do not repair TVs or other devices."
    ctaLabel="Call (210) 981-4098"
    ctaHref="tel:2109814098"
    secondaryCta="Or book a service call"
    secondaryHref="/contact-kz-audio-video-san-antonio-tx/"
    imageSrc="/images/projects/asanka-theater/theater-room-san-antonio-tx-wide.jpg"
    imageAlt="AV repair and home theater service in San Antonio Texas"
    imagePosition="object-center"
    scrim={0.55}
  />

  <TrustBar />

  <!-- Services -->
  <section class="section bg-slate-surface">
    <div class="container-main">
      <p class="overline mb-3">What a Service Call Fixes</p>
      <h2 class="font-display text-h2 text-warm-white mb-6">
        We Fix the Setup, Not the Device
      </h2>
      <p class="text-body-lg text-stone mb-5 max-w-2xl">
        KZ Audio & Video fixes AV setups in San Antonio, not equipment. When a home theater, surround sound system, camera system or whole-house music system stops working, the cause is often the setup: a cable or internet company moved the wrong wires, an installer walked away before the job was done, or a setting changed and nobody knows which one. That is what a KZ service call is for. We trace the wiring, check every connection and setting, and get the system working again, whether we installed it or not.
      </p>
      <p class="text-body-lg text-stone mb-12 max-w-2xl">
        We do not repair TVs, receivers, projectors, speakers or other devices. If one device stopped working on its own and nothing else in the house changed, the maker's warranty or support line is the right call, not a service visit, and we will say so up front.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {[
          { title: 'Systems an Installer Left Not Working', desc: 'Your installer stopped answering and the cameras, music or theater never worked right? We work out what was installed and how it was wired, finish what was left undone, and get it working.' },
          { title: 'After the Cable or Internet Company', desc: 'An install or service visit can unplug, move or reroute the wires your system depends on. We find what changed and put it back so everything works together again.' },
          { title: 'Surround Sound Not Working', desc: 'Dead channels, no sound from the surrounds, speakers wired backward, wrong speaker settings in the receiver. We fix the wiring and the settings. We do not repair the receiver or speakers themselves.' },
          { title: 'HDMI and Connection Problems', desc: 'HDMI handshake failures, no picture, 4K or Dolby Atmos not coming through, a long run to the projector that drops out. These are connection and settings problems, and they are more common than they should be.' },
          { title: 'Cameras, Wi-Fi and Whole-House Music', desc: 'Cameras that went offline, Wi-Fi that drops, music that stopped playing in some rooms. Bad cabling and network setup are exactly what we fix.' },
          { title: 'Inherited Systems and Recalibration', desc: 'Bought a house with a system nobody explained? We map what you have, get it working, and tell you what is worth keeping. Rooms change and people move things, so we recalibrate systems too, whether we installed them or not.' },
        ].map(({ title, desc }) => (
          <div class="card p-7 flex flex-col gap-3">
            <h3 class="font-sans font-semibold text-h4 text-warm-white">{title}</h3>
            <p class="text-body-sm text-stone leading-relaxed">{desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <TestimonialsSection featured={featured} />

  <FAQAccordion
    heading="AV Repair: Frequently Asked Questions"
    faqs={faqs}
  />

  <CTASection
    heading="Something Not Working Right?"
    body="Call or book a service visit. We'll come out, find what is wrong with the setup, and tell you straight what it takes to get it working. If it is one device that broke on its own, its maker's support line is the faster fix."
    ctaLabel="Call (210) 981-4098"
    ctaHref="tel:2109814098"
    secondaryLabel="Book a Service Visit"
    secondaryHref="/contact-kz-audio-video-san-antonio-tx/"
  />

</BaseLayout>
