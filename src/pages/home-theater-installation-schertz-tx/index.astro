---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroSection from '../../components/sections/HeroSection.astro';
import TrustBar from '../../components/sections/TrustBar.astro';
import FAQAccordion from '../../components/sections/FAQAccordion.astro';
import CTASection from '../../components/sections/CTASection.astro';

const schema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Home Theater Installation Schertz TX",
  "provider": {
    "@type": "LocalBusiness",
    "@id": "https://kzaudioandvideo.com/#business",
    "name": "KZ Audio & Video",
    "url": "https://kzaudioandvideo.com",
    "telephone": "+12109814098"
  },
  "areaServed": "Schertz, TX",
  "serviceType": "Home Theater Installation",
  "description": "Custom home theater and AV installation in Schertz TX and the Northeast San Antonio corridor. Dedicated theaters, whole-house audio, outdoor AV, new construction pre-wire. KZ Audio & Video, in business since 1997.",
  "url": "https://kzaudioandvideo.com/home-theater-installation-schertz-tx/"
};

const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://kzaudioandvideo.com" },
    { "@type": "ListItem", "position": 2, "name": "Home Theater Installation Schertz TX" }
  ]
};

const faqs = [
  {
    question: "Do you serve Schertz and the surrounding Northeast SA corridor?",
    answer: "Yes. We work throughout Schertz, Cibolo, Universal City, Live Oak, and the communities along the Highway 78 and FM 3009 corridors. The Northeast SA area has been one of our most active markets as development has accelerated. We come to you — the consultation is always free.",
  },
  {
    question: "What does home theater installation cost in Schertz?",
    answer: "A media room setup — large 4K display, 5.1 surround sound, clean wiring — typically runs $10,000–$15,000 installed. A dedicated theater room with 4K projection, Dolby Atmos surround, and tiered seating runs $15,000–$40,000. A premium theater with laser projection, motorized seating, and full automation runs $40,000–$80,000+. We quote after seeing the space — never based on square footage or a phone description.",
  },
  {
    question: "Can you pre-wire a new construction home in Schertz or Cibolo?",
    answer: "Yes, and pre-wire is the most cost-effective way to build an AV system into a new home. If your home is still in the framing or rough-in stage, we can run all low-voltage cabling — speaker wire, HDMI, network, security — before the walls close. This eliminates retrofit fishing later and keeps the system cleaner and less expensive. We coordinate directly with your builder.",
  },
  {
    question: "Do you work near Randolph AFB / JBSA-Randolph?",
    answer: "Yes. We serve homeowners throughout the JBSA-Randolph area and the communities between Universal City and Schertz. Military families and civilian employees near the base are a common client for us — particularly for media rooms and surround sound systems in newer construction homes.",
  },
  {
    question: "What's the difference between a media room and a dedicated home theater?",
    answer: "A media room is a shared-use space — it might be a living room, bonus room, or flex room with a large TV, quality surround sound, and clean wiring. It works for everyday use and casual watching. A dedicated home theater is a single-purpose room: light-controlled, acoustically treated, designed specifically around projection and immersive sound. Schertz new construction homes often have a media room or flex room that's perfect for a dedicated theater conversion.",
  },
  {
    question: "Can you add whole-house audio to a Schertz home?",
    answer: "Absolutely. Whole-house audio is one of our most popular additions in newer construction homes throughout the Northeast corridor. We install Sonos multi-zone systems with in-ceiling speakers throughout the main living areas, master bedroom, and covered patio — all controlled from a single app. If your home was pre-wired for audio, we can often tie into the existing infrastructure.",
  },
];
---

<BaseLayout
  title="Home Theater Installation Schertz TX | KZ Audio & Video"
  description="Custom home theater installation in Schertz TX. Dedicated theaters, whole-house audio, and new construction pre-wire in northeast SA. Call (210) 981-4098."
  schema={[schema, breadcrumb]}
>

  <HeroSection
    overline="Schertz · Cibolo · Universal City · Northeast San Antonio"
    heading="Home Theater Installation in Schertz, TX"
    subhead="One of the fastest-growing corridors in the San Antonio metro. We install home theaters, whole-house audio, and AV systems throughout Schertz, Cibolo, and the communities along Highway 78 — including new construction and established neighborhoods near Randolph AFB."
    ctaLabel="Book a Free Consultation"
    ctaHref="/contact-kz-audio-video-san-antonio-tx/"
    secondaryCta="Call (210) 981-4098"
    secondaryHref="tel:2109814098"
    imageSrc="/images/projects/monty-theater/home-theater-near-san-antonio-hero.jpg"
    imageAlt="Custom home theater installation in Schertz Texas"
    compact={true}
  />

  <TrustBar />

  <!-- Local context -->
  <section class="section bg-slate-surface">
    <div class="container-main">
      <p class="overline mb-3 reveal">Schertz, TX — Guadalupe County</p>
      <h2 class="font-display text-h2 text-warm-white mb-6 reveal reveal-delay-1">
        Northeast San Antonio's Fastest-Growing Suburb
      </h2>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
        <div>
          <p class="text-body-lg text-stone mb-6 reveal reveal-delay-2">
            Schertz sits at the northeastern edge of the San Antonio metro, straddling Guadalupe and Comal counties along the IH-35 corridor. It's one of the fastest-growing communities in the entire metro — new residential developments are actively underway along FM 3009, FM 1518, and the Highway 78 corridor, and established neighborhoods close to JBSA-Randolph have seen consistent demand for years.
          </p>
          <p class="text-body text-stone mb-6 reveal reveal-delay-3">
            The population is a mix of active-duty military and civilian employees from Randolph, San Antonio commuters drawn by the newer housing stock, and longtime Schertz families. Cibolo is directly adjacent and is often lumped together with Schertz in terms of market character — newer construction, larger floor plans, and buyers with the income to invest in their homes. Universal City is a few minutes west, and New Braunfels is roughly 20 minutes north on IH-35.
          </p>
          <p class="text-body text-stone reveal reveal-delay-3">
            KZ Audio & Video has been serving the Northeast SA corridor for years. Kelly, Billy, and Julian are the team — no subcontractors, no day laborers. We come to you for the consultation, we do the installation, and we're the ones you call afterward if anything ever needs attention.
          </p>
        </div>
        <div class="flex flex-col gap-6">
          <div class="card p-6 reveal reveal-delay-2">
            <h3 class="font-sans font-semibold text-warm-white mb-2">New Construction Pre-Wire</h3>
            <p class="text-body-sm text-stone">Schertz and Cibolo are seeing active new home construction. If your build is in framing, we can run all AV, speaker, and network cabling before the walls close — eliminating costly retrofits later. We work directly with your builder.</p>
          </div>
          <div class="card p-6 reveal reveal-delay-3">
            <h3 class="font-sans font-semibold text-warm-white mb-2">Military-Friendly Scheduling</h3>
            <p class="text-body-sm text-stone">We serve a lot of families near JBSA-Randolph and understand military schedules. We work around deployment timelines, PCS windows, and base housing situations to make the project as smooth as possible.</p>
          </div>
          <div class="card p-6 reveal reveal-delay-4">
            <h3 class="font-sans font-semibold text-warm-white mb-2">SA/Austin Commuter Homes</h3>
            <p class="text-body-sm text-stone">Many Schertz homeowners commute to San Antonio or Austin. When you're away most of the week, phone control and whole-house audio systems make your time at home count. We build systems that are simple to operate from anywhere.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Services -->
  <section class="section">
    <div class="container-main">
      <p class="overline mb-3 reveal">What We Install in Schertz</p>
      <h2 class="font-display text-h2 text-warm-white mb-6 reveal reveal-delay-1">
        Every AV Service for Northeast SA Homes
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        {[
          {
            title: "Dedicated Home Theater",
            desc: "4K and laser projection, Dolby Atmos surround sound, tiered or flat seating platforms, acoustic treatment, and full automation. We design around your specific room — media rooms, bonus rooms, and flex rooms in new Schertz construction all have different challenges.",
          },
          {
            title: "Media Room & Living Room AV",
            desc: "A 75\" or 85\" 4K display, a quality Dolby Atmos soundbar or 5.1 system, and clean hidden wiring transforms a living room into a genuinely great space for watching. Most homes in the $400K–$700K range benefit more from a well-executed media room than a full dedicated theater.",
          },
          {
            title: "Whole-House Audio",
            desc: "Multi-zone Sonos in-ceiling speaker systems for the kitchen, living areas, master bedroom, and covered patio. Common in newer Schertz and Cibolo construction where the open-plan layout makes distributed audio especially effective.",
          },
          {
            title: "Outdoor AV",
            desc: "Covered patio TVs, weatherproof speakers, and outdoor projector setups for Texas outdoor living. We spec everything for heat and UV exposure and tie outdoor zones into your whole-house system.",
          },
        ].map(({ title, desc }) => (
          <div class="card p-7 reveal">
            <h3 class="font-sans font-semibold text-h4 text-warm-white mb-3">{title}</h3>
            <p class="text-body text-stone leading-relaxed">{desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Why KZ -->
  <section class="section bg-slate-surface">
    <div class="container-main">
      <p class="overline mb-3 reveal">Why KZ Audio & Video</p>
      <h2 class="font-display text-h2 text-warm-white mb-6 reveal reveal-delay-1">
        In Business Since 1997. No Subcontractors. 5.0 on Google.
      </h2>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
        <div>
          <p class="text-body-lg text-stone mb-6 reveal reveal-delay-2">
            KZ Audio & Video was founded in 1997. Kelly, Billy, and Julian are the team. They're the ones who answer the phone when you call, show up for the consultation, do the work, and pick up the phone afterward if anything needs attention. We don't use subcontractors or hire day labor for installs.
          </p>
          <p class="text-body text-stone mb-6 reveal reveal-delay-3">
            That consistency matters in a market like Schertz and Cibolo where a lot of contractors are rotating through new developments. The same people who design your system install it — and they've been doing this long enough to know what actually holds up and what creates service calls six months later.
          </p>
          <p class="text-body text-stone reveal reveal-delay-3">
            We have a 5.0 Google rating because we give honest recommendations. If a media room is a better fit for your space than a dedicated theater, we'll tell you that. If a mid-range system gives you 90 percent of the experience of a premium system for half the price, we'll tell you that too. The consultation is free and comes with no sales pressure.
          </p>
        </div>
        <div class="flex flex-col gap-4">
          {[
            { stat: "Since 1997", label: "In the AV business in San Antonio" },
            { stat: "5.0 Stars", label: "Google rating — every review is real" },
            { stat: "No Subs", label: "Kelly, Billy, and Julian do every install" },
            { stat: "Free", label: "In-home consultation, always — no travel fee" },
          ].map(({ stat, label }) => (
            <div class="card p-5 flex items-center gap-5 reveal">
              <p class="font-display text-h3 text-gold shrink-0 w-32">{stat}</p>
              <p class="text-body text-stone">{label}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <FAQAccordion
    heading="Home Theater Installation Schertz TX — Frequently Asked Questions"
    faqs={faqs}
  />

  <CTASection
    heading="Ready to Get Started in Schertz?"
    body="Book a free consultation. We'll come to your Schertz or Cibolo home, walk the space, and design a system that fits the house and how you actually use it."
    ctaLabel="Book a Free Consultation"
    ctaHref="/contact-kz-audio-video-san-antonio-tx/"
    secondaryLabel="Call (210) 981-4098"
    secondaryHref="tel:2109814098"
  />

</BaseLayout>
