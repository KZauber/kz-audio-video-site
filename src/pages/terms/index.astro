---
import BaseLayout from '../../layouts/BaseLayout.astro';

const schema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Terms of Service — KZ Audio & Video",
  "url": "https://kzaudioandvideo.com/terms/"
};
---

<BaseLayout
  title="Terms of Service | KZ Audio & Video"
  description="Terms of Service for KZ Audio & Video. The terms that govern your use of kzaudioandvideo.com and the home theater and AV services we provide in San Antonio TX."
  schema={schema}
  chatWidget={false}
>
  <section class="section bg-charcoal pt-32">
    <div class="container-content">
      <p class="overline mb-3">Terms of Service</p>
      <h1 class="font-display text-h1 text-warm-white mb-4">Terms of Service</h1>
      <p class="text-body text-stone mb-12">Last updated: June 17, 2026</p>

      <div class="flex flex-col gap-10">

        <div>
          <p class="text-body text-stone leading-relaxed">
            These Terms of Service ("Terms") govern your use of kzaudioandvideo.com and the services provided
            by KZ Audio &amp; Video ("we," "us," "our"). By using our website or contacting us, you agree to these Terms.
          </p>
        </div>

        <div>
          <h2 class="font-sans font-semibold text-h3 text-warm-white mb-3">Our Services</h2>
          <p class="text-body text-stone leading-relaxed">
            We provide home theater, audio, and audio/video installation services in San Antonio and the
            surrounding Texas Hill Country. Information on this site is for general purposes. Consultations,
            estimates, and quotes are not binding contracts; a project is confirmed only by a separate written
            agreement between you and KZ Audio &amp; Video.
          </p>
        </div>

        <div>
          <h2 class="font-sans font-semibold text-h3 text-warm-white mb-3">Use of This Website</h2>
          <p class="text-body text-stone leading-relaxed">
            You agree to use this website lawfully and not to misuse our forms, attempt to disrupt the site, or
            submit false information. We may update, suspend, or remove content at any time.
          </p>
        </div>

        <div>
          <h2 class="font-sans font-semibold text-h3 text-warm-white mb-3">Communications</h2>
          <p class="text-body text-stone leading-relaxed">
            When you submit a form or contact us, you consent to receive calls, texts, and emails from us about
            your inquiry, as described in our
            <a href="/privacy/" class="text-gold hover:text-gold-light underline">Privacy Policy</a>. You can opt
            out of texts at any time by replying STOP.
          </p>
        </div>

        <div>
          <h2 class="font-sans font-semibold text-h3 text-warm-white mb-3">Intellectual Property</h2>
          <p class="text-body text-stone leading-relaxed">
            All content on this site — text, images, logos, and project photos — is the property of
            KZ Audio &amp; Video and may not be copied or reused without permission.
          </p>
        </div>

        <div>
          <h2 class="font-sans font-semibold text-h3 text-warm-white mb-3">Disclaimer &amp; Limitation of Liability</h2>
          <p class="text-body text-stone leading-relaxed">
            This website is provided "as is" without warranties of any kind. To the fullest extent permitted by
            law, KZ Audio &amp; Video is not liable for any indirect or incidental damages arising from your use
            of this website.
          </p>
        </div>

        <div>
          <h2 class="font-sans font-semibold text-h3 text-warm-white mb-3">Governing Law</h2>
          <p class="text-body text-stone leading-relaxed">
            These Terms are governed by the laws of the State of Texas.
          </p>
        </div>

        <div>
          <h2 class="font-sans font-semibold text-h3 text-warm-white mb-3">Contact Us</h2>
          <p class="text-body text-stone leading-relaxed">
            KZ Audio &amp; Video<br />
            614 C South Business 35, New Braunfels, TX 78130<br />
            Phone: <a href="tel:2109814098" class="text-gold hover:text-gold-light">(210) 981-4098</a><br />
            Email: <a href="mailto:kelly@kzaudioandvideo.com" class="text-gold hover:text-gold-light">kelly@kzaudioandvideo.com</a>
          </p>
        </div>

      </div>
    </div>
  </section>
</BaseLayout>
