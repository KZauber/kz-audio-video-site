---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroSection from '../../components/sections/HeroSection.astro';
import TrustBar from '../../components/sections/TrustBar.astro';
import TestimonialsSection from '../../components/sections/TestimonialsSection.astro';
import FAQAccordion from '../../components/sections/FAQAccordion.astro';
import CTASection from '../../components/sections/CTASection.astro';

const schema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Smart Home Automation San Antonio TX",
  "provider": {
    "@type": "LocalBusiness",
    "name": "KZ Audio & Video",
    "url": "https://kzaudioandvideo.com",
    "telephone": "+12109814098"
  },
  "areaServed": "San Antonio, TX",
  "description": "Smart home automation and AV control system installation in San Antonio TX. Whole-home AV control, lighting integration, scene programming, and new construction pre-wire. In the audio and home technology business since 1997.",
  "url": "https://kzaudioandvideo.com/smart-home-automation-san-antonio/"
};

const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://kzaudioandvideo.com" },
    { "@type": "ListItem", "position": 2, "name": "Smart Home Automation San Antonio TX" }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is smart home automation?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Smart home automation connects your home's AV systems, lighting, and technology into a single unified control system. Instead of managing a TV remote, a receiver remote, a lighting app, and a streaming app separately, everything operates from one interface — a touchscreen, a tablet, or a voice command. KZ Audio & Video designs and installs systems that actually work reliably, not just systems that demo well."
      }
    },
    {
      "@type": "Question",
      "name": "What systems can you automate in a San Antonio home?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "We integrate AV systems (home theater, whole-house audio, TV, streaming), lighting (smart switches and dimmers), and control systems that tie it all together. We also handle network infrastructure — the backbone that makes everything work reliably. Our focus is AV-centered smart home systems, not alarm or HVAC automation."
      }
    },
    {
      "@type": "Question",
      "name": "Do you work with Sonos, Control4, or Crestron?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Sonos is a central part of many of the whole-house audio systems we install and integrates well with most smart home platforms. For AV control systems, we work with platforms appropriate for the project scope — from Sonos-native control for simpler setups to more comprehensive control systems for larger homes. We recommend what's right for your home and budget, not what has the highest margin."
      }
    },
    {
      "@type": "Question",
      "name": "Can you automate an existing home or is this only for new construction?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Both. New construction is ideal because we can pre-wire for everything before the walls close. But we work in finished homes across San Antonio regularly. Wireless control systems and smart switches eliminate most of the need for new wire runs in existing homes. We'll assess your home and tell you what's practical and what isn't."
      }
    },
    {
      "@type": "Question",
      "name": "Do you program the system and train us how to use it?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Programming and a homeowner walkthrough are part of every smart home install we do. A system you can't figure out is a system you won't use. We program scenes, label everything clearly, and walk you through every function before we leave. If something's not right after you've lived with it, call us."
      }
    },
    {
      "@type": "Question",
      "name": "Is smart home automation worth it?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes — if the system is designed correctly. The value is in daily convenience: one button or one voice command controls your TV, audio, lighting, and streaming instead of managing four different remotes and three apps. Systems that fail are ones that were over-engineered for how the homeowner actually lives, or programmed and left without a proper walkthrough. A well-designed, well-programmed smart home system gets used every single day. A poorly designed one collects dust. We design for how you actually live."
      }
    },
  ],
};

const faqs = [
  {
    question: 'What is smart home automation?',
    answer: "Smart home automation connects your home's AV systems, lighting, and technology into a single unified control system. Instead of managing a TV remote, a receiver remote, a lighting app, and a streaming app separately, everything operates from one interface — a touchscreen, a tablet, or a voice command. KZ Audio & Video designs and installs systems that actually work reliably, not just systems that demo well.",
  },
  {
