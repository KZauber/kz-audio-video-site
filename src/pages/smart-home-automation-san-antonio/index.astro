const featured = {
  name: 'San Antonio Homeowner',
  location: 'San Antonio, TX',
  service: 'Home Theater Client — Nearly 10 Years',
  quote: "I've been a customer of KZ Audio for going on a decade. Kelly and crew have always been great to work with. They're honest and will recommend what actually works for your situation rather than upselling you on equipment you don't need. I've never had a bad experience with them.",
};
---

<BaseLayout
  title="Smart Home Automation San Antonio TX | KZ Audio & Video"
  description="Smart home automation and AV control system installation in San Antonio TX. Unified AV control, lighting integration, scene programming, new construction pre-wire. In the audio business since 1997. Call (210) 981-4098."
  schema={[schema, breadcrumb, faqSchema]}
>

  <HeroSection
    overline="Smart Home Automation · San Antonio · Hill Country · Since 2001"
    heading="Smart Home Automation in San Antonio TX"
    subhead="One interface for your home theater, whole-house audio, TV, streaming, and lighting. KZ Audio & Video designs and installs smart home systems that work the way you actually live — not the way a showroom demo does."
    ctaLabel="Book a Free Consultation"
    ctaHref="/contact-kz-audio-video-san-antonio-tx/"
    secondaryCta="Or call: (210) 981-4098"
    secondaryHref="tel:2109814098"
    imageSrc="/images/projects/asanka-theater/home-theater-led-lights-san-antonio.jpg"
    imageAlt="Smart home AV system with LED lighting control installed in San Antonio Texas"
  />

  <TrustBar />

  <!-- Services -->
  <section class="section bg-slate-surface">
    <div class="container-main">
      <p class="overline mb-3">Smart Home AV Systems</p>
      <h2 class="font-display text-h2 text-warm-white mb-6">
        Everything Controlled from One Place
      </h2>
      <p class="text-body-lg text-stone mb-12 max-w-2xl">
        The problem with most "smart" home systems is that they're not actually unified — you end up with five apps and three remotes instead of one. We design AV-centered smart home systems where everything talks to everything else, and you control all of it from a single interface.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {[
          {
            title: 'Unified AV Control',
            desc: 'One remote, one app, or one touchscreen controls your TV, projector, receiver, streaming, and whole-house audio. No more hunting for which remote does what.',
          },
          {
            title: 'Whole-House Audio Integration',
            desc: 'Sonos and multi-room audio systems integrated into your smart home control. Play the same music everywhere or different audio in each room — controlled from one interface.',
          },
          {
            title: 'Lighting Control',
            desc: 'Smart switches, dimmers, and scene programming. "Watch a movie" dims the lights, closes the shades, and turns on the projector. One button does all of it.',
          },
          {
            title: 'Scene Programming',
            desc: 'Programmed scenes for the way you actually use your home — Movie Night, Entertaining, Good Morning, Away. We program them, label them clearly, and walk you through everything.',
          },
          {
            title: 'New Construction Pre-Wire',
            desc: 'The right time to plan a smart home is before the walls close. We work with custom home builders in San Antonio and the Hill Country on full low-voltage pre-wire for AV and smart home systems.',
          },
          {
            title: 'Existing Home Upgrades',
            desc: 'Wireless control systems and smart switches make most smart home functionality possible in finished homes without tearing up walls. We assess your home and tell you what\'s practical.',
          },
        ].map(({ title, desc }) => (
          <div class="card p-7 flex flex-col gap-3">
            <h3 class="font-sans font-semibold text-h4 text-warm-white">{title}</h3>
            <p class="text-body-sm text-stone leading-relaxed">{desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Why it matters section -->
  <section class="section bg-charcoal">
    <div class="container-main">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-start">
        <div>
          <p class="overline mb-3">The KZ Approach</p>
          <h2 class="font-display text-h2 text-warm-white mb-6">
            Systems That Work the Way You Live
          </h2>
          <p class="text-body-lg text-stone mb-6">
            Smart home systems fail in two ways: they're too complicated to use daily, or they're unreliable when you actually need them. Both failures come from a system that wasn't designed correctly in the first place.
          </p>
          <p class="text-body text-stone mb-6">
            We start by asking how you use your home — not by showing you what's technically possible. The right system for a family with kids is different from the right system for someone who wants a serious home theater with lighting control. We design around how you actually live.
          </p>
          <p class="text-body text-stone">
            Everything we install gets programmed, tested, and walked through with you before we leave. If it's not intuitive, it's not done.
          </p>
        </div>
        <div class="flex flex-col gap-8 pt-2">
          {[
            {
              title: 'In the audio business since 1997',
              desc: 'Smart home technology has changed. The fundamentals of a well-designed system haven\'t. We\'ve been doing this long enough to know what works and what fails.',
            },
            {
              title: 'No outsourced labor',
              desc: 'Every system we install, we program ourselves. There\'s no subcontractor who set up the control system and left without documentation. We own the whole install.',
            },
            {
              title: 'Free in-home consultation',
              desc: 'We come to your home, look at the space, talk through what you want, and give you an honest recommendation and a firm quote. No charge, no pressure.',
            },
          ].map(({ title, desc }) => (
            <div class="flex flex-col gap-2">
              <h3 class="font-sans font-semibold text-h4 text-warm-white">{title}</h3>
              <p class="text-body text-stone">{desc}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <TestimonialsSection featured={featured} />

  <FAQAccordion
    heading="Smart Home Automation — Frequently Asked Questions"
    faqs={faqs}
  />

  <CTASection
    heading="Ready to Talk Smart Home?"
    body="Book a free, no-pressure consultation. We'll come to your home in San Antonio, look at what you have, talk through what you want, and give you an honest recommendation."
    ctaLabel="Book a Free Consultation"
    ctaHref="/contact-kz-audio-video-san-antonio-tx/"
    secondaryLabel="Call (210) 981-4098"
    secondaryHref="tel:2109814098"
  />

</BaseLayout>
