---
import BaseLayout from "../../layouts/BaseLayout.astro";
import HeroSection from "../../components/sections/HeroSection.astro";
import TrustBar from "../../components/sections/TrustBar.astro";
import CTASection from "../../components/sections/CTASection.astro";

const schema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Surround Sound Installation Cost: San Antonio TX",
  "provider": {
    "@type": "LocalBusiness",
    "name": "KZ Audio & Video",
    "url": "https://kzaudioandvideo.com",
    "telephone": "+12109814098",
  },
  "areaServed": ["San Antonio", "Boerne", "Canyon Lake", "Helotes", "Bulverde", "Stone Oak", "New Braunfels", "Schertz", "Seguin"],
  "description": "What surround sound installation costs in San Antonio TX. Real price ranges for soundbars, 5.1, 7.1, and Dolby Atmos systems, an instant estimate calculator, and answers to common cost questions.",
  "url": "https://kzaudioandvideo.com/surround-sound-cost-san-antonio/",
  "offers": {
    "@type": "AggregateOffer",
    "priceCurrency": "USD",
    "lowPrice": "800",
    "highPrice": "25000",
    "offerCount": "5",
  },
};

const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://kzaudioandvideo.com" },
    { "@type": "ListItem", "position": 2, "name": "Surround Sound Cost San Antonio" },
  ],
};

const costFaqs = [
  {
    question: "How much does surround sound installation cost in San Antonio?",
    answer:
      "Surround sound in San Antonio typically costs $3,000 to $5,000 for a 5.1 or 7.1 system (speakers, subwoofer, and AV receiver, added to a TV or projector you already have). A premium soundbar with a wireless subwoofer is a cheaper option at $800 to $2,000 installed. A true 5.1 system, three front speakers, two surrounds, and a subwoofer with an AV receiver, runs around $3,000 installed, and a 7.1 system runs up toward $5,000. Adding Dolby Atmos brings it to $6,000 to $7,000, because Atmos puts one or two pairs of height speakers in the ceiling, each with its own wire run and install, and it needs an Atmos-capable receiver. A reference 9.2.4 Atmos system is part of a dedicated theater build rather than a standalone surround add-on. Cost depends on speaker brand, whether speakers are in-wall or in-ceiling versus bookshelf, receiver capability, and the labor to fish wire through finished walls. KZ Audio & Video designs the system around your room and gives a written quote after a free in-home visit.",
  },
  {
    question: "Is a soundbar or a full surround sound system better for the money?",
    answer:
      "It depends on the room and how you use it. A premium soundbar with a wireless subwoofer ($800 to $2,000 installed) is the right call for a bedroom, office, or a living room where clean looks matter more than immersion, modern soundbars sound genuinely good and hide easily. A full 5.1 or 7.1 surround system ($3,000 to $5,000) is worth it for a dedicated media room or a great room where you watch movies and sports seriously, because real speakers placed around the room create immersion a single bar cannot match. For most San Antonio living rooms, we honestly recommend a quality soundbar unless you want true cinema sound. We tell you which makes sense for your space rather than upselling speakers you will not appreciate.",
  },
  {
    question: "What is the cost difference between 5.1, 7.1, and Dolby Atmos?",
    answer:
      "The jump comes from speaker count and the receiver needed to drive them. A 5.1 system, three fronts, two surrounds, one subwoofer, runs around $3,000 installed. A 7.1 system adds two more surround speakers and runs about $3,500 to $5,000. Dolby Atmos adds overhead sound: a 5.1.2 or 7.1.4 layout puts one or two pairs of speakers in the ceiling for height effects, each with its own wire run, and it needs an Atmos-capable receiver, so an Atmos system runs $6,000 to $7,000. A reference 9.2.4 Atmos system belongs to a dedicated theater build, not a standalone surround add-on. More channels mean more immersion but also more equipment, wiring, and calibration. For a dedicated theater we usually recommend Atmos; for a living room, a clean 5.1 often makes more practical sense.",
  },
  {
    question: "How much more do in-wall and in-ceiling speakers cost than bookshelf speakers?",
    answer:
      "In-wall and in-ceiling speakers themselves cost roughly the same as comparable bookshelf models, but the installation labor is higher because we cut into the wall or ceiling, run wire through framing, and finish the openings cleanly. That labor is already built into the $3,000 to $5,000 range: an in-wall or in-ceiling build simply lands you toward the top of it rather than the bottom. The payoff is a clean, built-in look with no speaker boxes or visible wires, which matters in a finished living space. In an existing finished room the wire has to be fished through closed walls, so retrofits sit higher than new construction. We assess the room and tell you exactly what is involved.",
  },
  {
    question: "Do I need a new AV receiver, and how much does one cost?",
    answer:
      "If your current receiver supports the number of channels and the features you want, you can keep it and save money. You need a new receiver when you are stepping up channels (for example, moving from 5.1 to 7.1 or adding Dolby Atmos height channels), when your receiver lacks 4K or HDMI passthrough for a new TV, or when it cannot decode current audio formats. A capable mid-range AV receiver runs about $600 to $1,200, and it is already included in the $3,000 to $5,000 system price. A high-end receiver or separate processor and amplifier is a dedicated-theater item. The receiver is the brain of the system, so we match it to your speakers and sources rather than overspending. We will tell you honestly whether your existing receiver is worth keeping.",
  },
  {
    question: "How much does it cost to add surround sound to an existing living room?",
    answer:
      "Adding surround sound to an existing San Antonio living room typically costs $3,000 to $5,000, depending on the system and the wiring. The biggest variable is whether speakers go in bookshelf or floor-standing positions (lower labor) or in-wall and in-ceiling (higher labor, cleaner look). In a finished room, wire has to be fished through closed walls and ceilings, which adds labor compared to new construction. A clean 5.1 system with a receiver, hidden wiring, and a subwoofer usually lands around $3,000, a 7.1 system runs toward $5,000, and adding Atmos height channels brings it to $6,000 to $7,000 because of the extra ceiling speakers and in-ceiling wiring. We do this retrofit work constantly across San Antonio, the drywall impact is minimal, and we assess your specific room before quoting so there are no surprises.",
  },
  {
    question: "Why does professional surround sound installation cost more than DIY?",
    answer:
      "The equipment is only part of a surround system: the performance comes from correct speaker placement, level matching, and calibration, which is what professional installation buys you. We position each speaker for your specific room dimensions and seating, run and conceal the wiring cleanly, configure the receiver, and calibrate levels and distances so dialogue is clear and effects are balanced. A DIY setup with speakers in the wrong spots and a receiver left on defaults often sounds worse than a cheaper system installed correctly. Professional installation also means no visible wires, proper in-wall work, and a system that actually integrates with your TV and sources. For a soundbar, DIY is reasonable. For a true surround system you want to enjoy for years, the calibration and clean install are where the value is.",
  },
  {
    question: "Does adding a second subwoofer improve sound, and what does it cost?",
    answer:
      "Yes, dual subwoofers are one of the best upgrades in surround sound, and most people underestimate the difference. Two subwoofers placed correctly smooth out bass across the whole room so every seat gets even, tight low end instead of one boomy spot and one weak spot. Adding a second subwoofer brings a system toward the top of the $3,000 to $5,000 range, and it is one of the highest-value upgrades you can make. In a dedicated theater we almost always recommend two subs; in a living room it depends on room size and how much you care about bass. The benefit is consistency and impact, not just volume. We measure the room and place the subs where they actually perform, rather than just tucking them in a corner.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": costFaqs.map((f) => ({
    "@type": "Question",
    "name": f.question,
    "acceptedAnswer": { "@type": "Answer", "text": f.answer },
  })),
};

const calcGroups = [
  {
    id: "system",
    label: "1. What system are you after?",
    options: [
      { t: "Soundbar + wireless sub", min: 800, max: 2000 },
      { t: "5.1 surround", min: 3000, max: 3500, on: true },
      { t: "7.1 surround", min: 3500, max: 5000 },
      { t: "Dolby Atmos (adds height speakers)", min: 6000, max: 7000 },
    ],
  },
  {
    id: "speakers",
    label: "2. Speaker style?",
    options: [
      { t: "Bookshelf / floor-standing", min: 0, max: 0, on: true },
      { t: "In-wall / in-ceiling (clean built-in look)", min: 0, max: 300 },
    ],
  },
  {
    id: "sub",
    label: "3. Subwoofer?",
    options: [
      { t: "One subwoofer", min: 0, max: 0, on: true },
      { t: "Dual subwoofers", min: 300, max: 500 },
    ],
  },
  {
    id: "wiring",
    label: "4. Your space is…",
    options: [
      { t: "New construction (pre-wire)", min: 0, max: 0, on: true },
      { t: "Existing finished room (retrofit)", min: 300, max: 700 },
    ],
  },
];
---

<BaseLayout
  title="Surround Sound Cost San Antonio TX | KZ Audio & Video"
  description="What does surround sound cost in San Antonio? Real price ranges for soundbars, 5.1, 7.1, and Dolby Atmos, an instant estimate calculator. Call (210) 981-4098."
  schema={[schema, breadcrumb, faqSchema]}
>
  <HeroSection
    heading="How Much Does Surround Sound Cost in San Antonio?"
    subhead="Real prices for soundbars, 5.1, 7.1, and Dolby Atmos systems, plus an instant estimate calculator and straight answers to the questions people ask most."
    imageSrc="/images/projects/asanka-theater/san-antonio-home-theater-project-cover.jpg"
    imageAlt="Surround sound installation in a San Antonio TX home theater with in-wall speakers"
    compact={true}
  />

  <TrustBar />

  <!-- Featured snippet target — self-contained quick answer for Google position 0 -->
  <section class="section bg-charcoal border-b border-smoke/40">
    <div class="container-main">
      <div class="max-w-3xl">
        <p class="overline mb-3">Quick Answer</p>
        <h2 class="font-display text-h2 text-warm-white mb-5">
          Surround Sound Installation Cost in San Antonio
        </h2>
        <div class="glass-card p-6 border-l-2 border-gold">
          <p class="text-body-lg text-stone leading-relaxed">
            Surround sound in San Antonio costs <strong class="text-warm-white">$800 to $7,000</strong>, depending on the system. A premium soundbar with a wireless subwoofer runs $800 to $2,000 installed. A full 5.1 or 7.1 surround system (speakers, subwoofer, and an AV receiver, added to a TV or projector you already have) runs $3,000 to $5,000. Adding Dolby Atmos, which puts one or two pairs of height speakers in the ceiling with their own wire runs, brings it to $6,000 to $7,000. That price is the audio only and does not include the display. The biggest variables are speaker placement (in-wall for a clean look versus bookshelf), whether the room is new construction or a finished retrofit, and receiver capability. A reference 9.2.4 Atmos system is part of a dedicated theater build. KZ Audio & Video has installed surround systems across San Antonio, Stone Oak, Alamo Heights, Boerne, Helotes, and Canyon Lake since 1999. Free in-home consultation with a written quote, no obligation.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Price comparison table -->
  <section class="section bg-slate-surface">
    <div class="container-main">
      <p class="overline mb-3">San Antonio Surround Sound Pricing</p>
      <h2 class="font-display text-h2 text-warm-white mb-6">
        From an $800 Soundbar to a $7,000 Dolby Atmos System
      </h2>
      <p class="text-body-lg text-stone mb-4 max-w-3xl">
        "Surround sound" covers everything from a single premium soundbar to a full Dolby Atmos system. It is the audio only, the speakers and receiver added to a TV or projector you already have. Where you land depends on the room, how seriously you watch, and whether speakers go in the wall or on a shelf.
      </p>
      <p class="text-body text-stone max-w-3xl mb-10">
        We have designed and installed surround systems across San Antonio and the Hill Country since 1999. Use the calculator below for an instant ballpark, then scroll down for honest answers to the cost questions. When you want a real number, we come to you, listen to the room, and put a written quote in your hands, free, no obligation.
      </p>

      <!-- Price comparison table -->
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse" style="min-width:600px;">
          <thead>
            <tr style="border-bottom:1px solid rgba(255,255,255,0.1);">
              <th class="font-sans font-semibold text-warm-white text-sm uppercase tracking-widest py-3 pr-6">System</th>
              <th class="font-sans font-semibold text-warm-white text-sm uppercase tracking-widest py-3 pr-6">San Antonio Price Range</th>
              <th class="font-sans font-semibold text-warm-white text-sm uppercase tracking-widest py-3 pr-6">Best For</th>
            </tr>
          </thead>
          <tbody>
            {[
              { system: "Soundbar + wireless sub", price: "$800 to $2,000", best: "Bedroom, office, or clean living room look" },
              { system: "5.1 Surround", price: "$3,000 to $3,500", best: "Living rooms and media rooms, serious TV watching" },
              { system: "7.1 Surround", price: "$3,500 to $5,000", best: "Large great rooms and media rooms" },
              { system: "Dolby Atmos (5.1.2 to 7.1.4)", price: "$6,000 to $7,000", best: "Adds in-ceiling height speakers for overhead sound" },
            ].map((row, i) => (
              <tr style={`border-bottom:1px solid rgba(255,255,255,${i < 4 ? '0.06' : '0'});`}>
                <td class="font-sans font-medium text-warm-white py-4 pr-6">{row.system}</td>
                <td class="font-sans text-gold font-semibold py-4 pr-6">{row.price}</td>
                <td class="font-sans text-stone py-4 pr-6 text-sm">{row.best}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="text-body-sm text-ash mt-4">Prices include equipment and professional installation in the San Antonio metro area. Exact quote depends on room, speaker placement, and wiring.</p>
    </div>
  </section>

  <section class="section bg-charcoal">
    <div class="container-main">
      <p class="overline mb-3">Instant Estimate</p>
      <h2 class="font-display text-h2 text-warm-white mb-4">
        Build Your Surround Sound Estimate
      </h2>
      <p class="text-body-lg text-stone mb-10 max-w-2xl">
        Pick what fits your space. Your estimated range updates as you go, a ballpark for the San Antonio market. Your written quote comes after a free in-home consultation.
      </p>

      <div class="grid grid-cols-1 lg:grid-cols-[1fr_360px] gap-8 items-start">
        <div class="flex flex-col gap-7" id="calc-form">
          {calcGroups.map((group) => (
            <div class="calc-group" data-group={group.id}>
              <h3 class="font-sans font-semibold text-body-lg text-warm-white mb-3">{group.label}</h3>
              <div class="flex flex-wrap gap-2.5">
                {group.options.map((opt) => (
                  <button
                    type="button"
                    class:list={["calc-opt", opt.on ? "is-active" : ""]}
                    data-min={opt.min}
                    data-max={opt.max}
                  >
                    {opt.t}
                  </button>
                ))}
              </div>
            </div>
          ))}
        </div>

        <div class="card p-7 lg:sticky lg:top-28">
          <p class="overline mb-2">Your Estimated Range</p>
          <p class="font-display text-h2 text-gold mb-1" id="calc-result">$3,000 to $3,500</p>
          <p class="text-body-sm text-ash mb-6">Estimate for the San Antonio market. Final price depends on equipment, speaker placement, and your room.</p>
          <a href="/contact-kz-audio-video-san-antonio-tx/" class="btn-primary gold-shimmer w-full text-center mb-3 cursor-pointer">
            Get My Exact Quote
          </a>
          <a href="tel:2109814098" class="btn-ghost w-full text-center cursor-pointer">
            Call (210) 981-4098
          </a>
          <p class="text-body-sm text-stone mt-5 leading-relaxed">
            We come to your home, listen to the room, and give you a written quote, at no charge.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-slate-surface">
    <div class="container-main">
      <p class="overline mb-3">Cost Questions, Answered</p>
      <h2 class="font-display text-h2 text-warm-white mb-12">
        San Antonio Surround Sound Cost: FAQ
      </h2>

      <div class="flex flex-col gap-10 max-w-3xl">
        {costFaqs.map((f) => (
          <article class="reveal">
            <h3 class="font-sans font-semibold text-h3 text-warm-white mb-4">{f.question}</h3>
            <p class="text-body text-stone leading-relaxed">{f.answer}</p>
          </article>
        ))}
      </div>

      <div class="mt-12 flex flex-wrap gap-4">
        <a href="/surround-sound-installation-san-antonio/" class="inline-flex items-center gap-2 text-gold font-sans font-medium cursor-pointer hover:text-warm-white transition-colors">
          See our surround sound installation service
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
        <a href="/home-theater-cost-san-antonio/" class="inline-flex items-center gap-2 text-gold font-sans font-medium cursor-pointer hover:text-warm-white transition-colors">
          Compare full home theater costs
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </section>

  <CTASection
    heading="Get a Real Number for Your Room."
    body="The calculator gives you a ballpark. A free in-home consultation gives you the truth. We come to you, listen to the space, and put a written quote in your hands. No pressure, no obligation."
    ctaLabel="Book a Free Consultation"
    ctaHref="/contact-kz-audio-video-san-antonio-tx/"
    secondaryLabel="Call (210) 981-4098"
    secondaryHref="tel:2109814098"
    bgImage="/images/projects/monty-theater/Home-Theater-Design-Build-Near-San-Antonio-Texas.jpeg.jpg"
  />

  <style>
    .calc-opt {
      border: 1px solid rgba(255, 255, 255, 0.14);
      background: rgba(255, 255, 255, 0.03);
      color: #C9CCD1;
      border-radius: 10px;
      padding: 0.6rem 0.95rem;
      font-size: 0.9rem;
      font-family: inherit;
      cursor: pointer;
      transition: all 0.16s ease;
      line-height: 1.2;
    }
    .calc-opt:hover { border-color: rgba(201, 168, 76, 0.5); color: #F5F3EE; }
    .calc-opt.is-active {
      border-color: #C9A84C;
      background: rgba(201, 168, 76, 0.14);
      color: #F5F3EE;
      box-shadow: 0 0 0 1px rgba(201, 168, 76, 0.4);
    }
  </style>

  <script is:inline>
    (function () {
      function format(n) { return "$" + Math.round(n).toLocaleString("en-US"); }
      function recalc() {
        var total = 0, top = 0;
        var active = document.querySelectorAll(".calc-opt.is-active");
        for (var i = 0; i < active.length; i++) {
          total += parseInt(active[i].getAttribute("data-min"), 10) || 0;
          top += parseInt(active[i].getAttribute("data-max"), 10) || 0;
        }
        var out = document.getElementById("calc-result");
        if (out) out.textContent = format(total) + " – " + format(top);
      }
      var groups = document.querySelectorAll(".calc-group");
      for (var g = 0; g < groups.length; g++) {
        var opts = groups[g].querySelectorAll(".calc-opt");
        for (var o = 0; o < opts.length; o++) {
          opts[o].addEventListener("click", function () {
            var parent = this.closest(".calc-group");
            var siblings = parent.querySelectorAll(".calc-opt");
            for (var s = 0; s < siblings.length; s++) siblings[s].classList.remove("is-active");
            this.classList.add("is-active");
            recalc();
          });
        }
      }
      recalc();
    })();
  </script>
</BaseLayout>
