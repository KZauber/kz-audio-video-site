const featured = {
  name: 'San Antonio Homeowner',
  location: 'San Antonio, TX',
  service: 'Home Theater',
  quote: 'KZ Audio and Video did a great job installing our home theater system. They were professional, on time, and their attention to detail was outstanding.',
};
---

<BaseLayout
  title="Surround Sound Installation San Antonio | KZ Audio & Video"
  description="Surround sound installation in San Antonio TX. 5.1, 7.1, and Dolby Atmos, properly placed and calibrated. In-wall and in-ceiling speakers. Call (210) 981-4098."
  schema={[schema, breadcrumb, faqSchema]}
>

  <HeroSection
    overline="Surround Sound · San Antonio · Hill Country · Since 1999"
    heading="Surround Sound Installation in San Antonio TX"
    subhead="5.1, 7.1, Dolby Atmos, properly placed, properly calibrated. Not just plugged in and set to default. KZ Audio & Video installs surround sound systems in San Antonio living rooms, media rooms, and dedicated home theaters."
    ctaLabel="Book a Free Consultation"
    ctaHref="/contact-kz-audio-video-san-antonio-tx/"
    secondaryCta="Or call: (210) 981-4098"
    secondaryHref="tel:2109814098"
    imageSrc="/images/projects/asanka-theater/theater-room-san-antonio-tx.jpg"
    imageAlt="Surround sound installation in San Antonio Texas home theater"
  />

  <TrustBar />

  <!-- What We Install -->
  <section class="section bg-slate-surface">
    <div class="container-main">
      <p class="overline mb-3">Surround Sound Systems</p>
      <h2 class="font-display text-h2 text-warm-white mb-6">
        Placement and Calibration Matter More Than the Gear
      </h2>
      <p class="text-body-lg text-stone mb-12 max-w-2xl">
        A $5,000 surround sound system installed correctly will outperform a $15,000 system that isn't. Speaker placement, proper wiring, and room calibration are what separate a real home theater experience from expensive noise. We do this right.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {[
          { title: '5.1 Surround Sound', desc: 'Front left/right, center channel, left/right surrounds, and a subwoofer. The standard configuration, designed and calibrated for your room.' },
          { title: '7.1 Surround Sound', desc: 'Adds side or rear surround speakers for larger rooms and more immersive sound staging. Properly placed based on your seating layout.' },
          { title: 'Dolby Atmos', desc: 'Height channels, in-ceiling or up-firing speakers, that place sound in three dimensions above and around you. Requires the right ceiling height and receiver.' },
          { title: 'In-Wall Speakers', desc: 'Flush-mounted front and surround speakers. Clean walls, no visible hardware except the grille. Run in new construction or fished through finished walls.' },
          { title: 'In-Ceiling Speakers', desc: 'Atmos height speakers and rear surrounds installed flush in the ceiling. Acoustically placed, not just centered in whatever tile is overhead.' },
          { title: 'Room Calibration', desc: "Audyssey MultEQ, Dirac, or manufacturer-specific room correction. Every system we install gets calibrated to the room it's in. No exceptions." },
        ].map(({ title, desc }) => (
          <div class="card p-7 flex flex-col gap-3">
            <h3 class="font-sans font-semibold text-h4 text-warm-white">{title}</h3>
            <p class="text-body-sm text-stone leading-relaxed">{desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Right System for the Room -->
  <section class="section bg-charcoal">
    <div class="container-main">
      <p class="overline mb-3">System Selection</p>
      <h2 class="font-display text-h2 text-warm-white mb-4">
        The Right Surround Sound System for Every Room
      </h2>
      <p class="text-body-lg text-stone mb-12 max-w-2xl">
        There is no universal answer. A living room, a media room, and a dedicated home theater each call for a different approach. We design for the room, not for the spec sheet.
      </p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {[
          {
            room: 'Living Room',
            system: '5.1 or Soundbar + Sub',
            desc: "Most living rooms have furniture, traffic flow, and aesthetic constraints that make a traditional 5.1 setup with floor-standing speakers impractical. In-wall speakers front and rear, or a premium soundbar with a dedicated subwoofer, deliver a serious upgrade without taking over the room. We design around how you actually use the space.",
            detail: 'Best for: casual viewing, sports, music, families',
          },
          {
            room: 'Media Room',
            system: '5.1 or 7.1 In-Wall',
            desc: "A dedicated media room, even one that doubles as a guest room or office, gives us more to work with. In-wall front and surround speakers, a proper AV receiver, and a calibrated subwoofer placed for maximum impact. If the ceiling allows it, we add a pair of Atmos height channels. This is where most San Antonio homeowners land for the best value.",
            detail: 'Best for: movie nights, gaming, serious TV watching',
          },
          {
            room: 'Home Theater',
            system: 'Dolby Atmos 7.1.4',
            desc: "A dedicated theater room is where we go all-in. In-wall front speakers, in-wall surrounds, in-ceiling Atmos height channels, dual subwoofers, acoustic treatment, and a receiver calibrated with Dirac or Audyssey XT32. The goal is a system where every seat in the room is a great seat, not just the center. We've built these across San Antonio, Boerne, Canyon Lake, and the Hill Country.",
            detail: 'Best for: dedicated rooms, premium experience, 4K projection',
          },
        ].map(({ room, system, desc, detail }) => (
          <div class="flex flex-col gap-4 border border-warm-white/10 rounded-lg p-7">
            <p class="overline text-gold">{room}</p>
            <h3 class="font-sans font-semibold text-h4 text-warm-white">{system}</h3>
            <p class="text-body-sm text-stone leading-relaxed">{desc}</p>
            <p class="text-body-sm text-stone/60 italic">{detail}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- What a Pro Install Looks Like -->
  <section class="section bg-slate-surface">
    <div class="container-main">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">
        <div>
          <p class="overline mb-3">The KZ Standard</p>
          <h2 class="font-display text-h2 text-warm-white mb-6">
            What a Professional Surround Sound Install Looks Like
          </h2>
          <p class="text-body text-stone mb-6">
            A lot of San Antonio homeowners have had a surround sound system installed by someone who plugged everything in, set the receiver to default, and left. That's not an installation, that's a delivery.
          </p>
          <p class="text-body text-stone mb-6">
            A proper installation starts with the room. Where are you sitting? Where can speakers physically go? What's the ceiling height? Is there a wall that will reflect differently than the others? We design the speaker layout before we touch a single wire.
          </p>
          <p class="text-body text-stone mb-6">
            Then we wire it right. In finished spaces, we fish wire through walls with minimal disruption. In new construction, we pre-wire at rough-in. Every cable is labeled. Every run is clean. The equipment rack is organized so it can be serviced years from now without a mess to untangle.
          </p>
          <p class="text-body text-stone">
            Finally, we calibrate. We run room correction, verify that every speaker is level-matched and time-aligned, and listen. We don't leave until it sounds the way it's supposed to. That last step is what most installers skip, and it's the difference between a system that sounds like a room and one that disappears.
          </p>
        </div>
        <div class="flex flex-col gap-5">
          {[
            { step: '01', title: 'Room Assessment', desc: 'We look at the space before spec\'ing anything. Dimensions, ceiling height, wall construction, seating position, and any acoustic challenges that need to be designed around.' },
            { step: '02', title: 'System Design', desc: 'Speaker placement plan, receiver selection, wire routing, and equipment. We match the system to your room and your budget, not the other way around.' },
            { step: '03', title: 'Clean Installation', desc: 'In-wall or in-ceiling speakers fished cleanly. Equipment rack organized and labeled. No wires hanging, no boxes sitting on shelves unless that\'s the design.' },
            { step: '04', title: 'Calibration', desc: 'Room correction software, level matching, time alignment. Every seat in the room should sound right, not just the sweet spot.' },
            { step: '05', title: 'Walkthrough', desc: 'We show you how to use the system before we leave. Not a manual, an actual walkthrough. You\'ll know what every input does and how to troubleshoot common issues.' },
          ].map(({ step, title, desc }) => (
            <div class="flex gap-5 items-start">
              <span class="font-display text-h3 text-gold/40 leading-none w-10 shrink-0">{step}</span>
              <div>
                <h3 class="font-sans font-semibold text-warm-white mb-1">{title}</h3>
                <p class="text-body-sm text-stone leading-relaxed">{desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Common Mistakes / Authority Section -->
  <section class="section bg-charcoal">
    <div class="container-main">
      <p class="overline mb-3">What We See</p>
      <h2 class="font-display text-h2 text-warm-white mb-4">
        The Most Common Surround Sound Mistakes in San Antonio Homes
      </h2>
      <p class="text-body-lg text-stone mb-12 max-w-2xl">
        We service and upgrade systems across San Antonio every week. The same problems come up constantly, most of them weren't the homeowner's fault.
      </p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {[
          {
            mistake: 'Surround speakers mounted too high or too low',
            fix: 'Dolby recommends surround speakers at ear level for 5.1, and slightly above for 7.1. In-ceiling speakers placed without regard for seating position lose the directional effect entirely. We measure before we mount.',
          },
          {
            mistake: 'Receiver left at factory defaults',
            fix: 'Every receiver ships with speaker sizes set to "large" and distances set to zero. Without calibration, the subwoofer fights the main speakers, dialogue gets buried, and explosions become distortion. Room correction fixes all of this.',
          },
          {
            mistake: 'Subwoofer placed in the corner by default',
            fix: 'A corner placement can reinforce bass but also creates boomy, one-note low end. We test subwoofer placement in the room and use calibration software to verify flat bass response at the listening position.',
          },
          {
            mistake: 'Center channel not at ear level',
            fix: 'The center channel carries 70% of the dialogue in a movie. If it\'s below or above the screen, voices sound disconnected from the picture. We position and angle the center channel for the primary seating position.',
          },
          {
            mistake: 'Wire run without labeling',
            fix: 'An unlabeled AV installation is a liability. When something needs service, troubleshooting takes hours instead of minutes. Every run we install is labeled at both ends, always.',
          },
          {
            mistake: 'Atmos speakers placed as if they\'re regular surrounds',
            fix: 'Dolby Atmos height channels need to be placed at specific angles relative to the listening position, not just wherever a ceiling joist cooperates. Incorrect Atmos placement produces no perceptible height effect and wastes the investment.',
          },
        ].map(({ mistake, fix }) => (
          <div class="card p-7 flex flex-col gap-3">
            <h3 class="font-sans font-semibold text-warm-white text-body-lg">{mistake}</h3>
            <p class="text-body-sm text-stone leading-relaxed">{fix}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <TestimonialsSection featured={featured} />

  <FAQAccordion
    heading="Surround Sound Installation: Frequently Asked Questions"
    faqs={faqs}
  />

  <section class="section bg-charcoal">
    <div class="container-main text-center max-w-2xl mx-auto">
      <p class="overline mb-3">Instant Estimate</p>
      <h2 class="font-display text-h2 text-warm-white mb-4">Wondering What Surround Sound Costs?</h2>
      <p class="text-body-lg text-stone mb-8">
        Soundbar, 5.1, 7.1, Dolby Atmos, use our free calculator to price out your specific setup in 30 seconds. No form. No email.
      </p>
      <a href="/surround-sound-cost-san-antonio/" class="btn-primary gold-shimmer cursor-pointer">
        Use the Free Cost Calculator →
      </a>
    </div>
  </section>

  <CTASection
    heading="Ready for Real Surround Sound?"
    body="Book a free consultation. We'll look at your room, talk through what format makes sense, and give you a quote."
    ctaLabel="Book a Free Consultation"
    ctaHref="/contact-kz-audio-video-san-antonio-tx/"
    secondaryLabel="Call (210) 981-4098"
    secondaryHref="tel:2109814098"
  />

</BaseLayout>
