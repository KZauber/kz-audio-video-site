const mistakes = [
  { t: 'No conduit.', d: 'Without it, every future upgrade means opening a wall.' },
  { t: 'Skipping the second subwoofer run in a dedicated theater.', d: 'A second sub is one of the biggest upgrades to how a theater sounds, so wire for two. A living room is usually fine with one.' },
  { t: 'Forgetting overhead speakers in a theater.', d: 'Dolby Atmos needs ceiling speakers, and they cannot be added cleanly after drywall.' },
  { t: 'Relying on Wi-Fi for everything.', d: 'Hardwire anything that stays in one place.' },
