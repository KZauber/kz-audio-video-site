---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroSection from '../../components/sections/HeroSection.astro';
import TrustBar from '../../components/sections/TrustBar.astro';
import ServicesGrid from '../../components/sections/ServicesGrid.astro';
import ProjectsGrid from '../../components/sections/ProjectsGrid.astro';
import TestimonialsSection from '../../components/sections/TestimonialsSection.astro';
import CTASection from '../../components/sections/CTASection.astro';

const schema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Home Theater Installation Fair Oaks Ranch",
  "provider": {
    "@type": "LocalBusiness",
    "name": "KZ Audio & Video",
    "url": "https://kzaudioandvideo.com",
    "telephone": "+12109814098"
  },
  "areaServed": "Fair Oaks Ranch, TX",
  "description": "Custom home theater and AV installation in Fair Oaks Ranch TX. KZ Audio & Video serves Bexar and Comal counties and the northwest San Antonio corridor.",
  "url": "https://kzaudioandvideo.com/home-theater-installation-fair-oaks-ranch-tx/"
};

const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://kzaudioandvideo.com" },
    { "@type": "ListItem", "position": 2, "name": "Home Theater Installation Fair Oaks Ranch TX" }
  ]
};

const projects = [
  {
    title: 'Dedicated Home Theater — Canyon Lake TX',
    location: 'Canyon Lake, TX',
    service: 'Home Theater',
    description: 'Full theater room with custom leather power recliner seating, blue LED accent lighting, projection system, and in-wall surround sound.',
    imageSrc: '/images/projects/monty-theater/Home-Theater-Near-San-Antonio-Texas.jpeg.jpg',
    imageAlt: 'Custom home theater with leather recliners and blue LED lighting near San Antonio Texas',
  },
  {
    title: 'Dedicated Home Theater — San Antonio TX',
    location: 'San Antonio, TX',
    service: 'Home Theater',
    description: 'Epson projector, Screen Innovations fixed-frame screen, Martin Logan on-wall speakers, LED accent lighting.',
    imageSrc: '/images/projects/asanka-theater/home-theater-led-lights-san-antonio.jpg',
    imageAlt: 'Home theater installation in San Antonio Texas with LED accent lighting and projection screen',
  },
];

const featured = {
  name: 'San Antonio Homeowner',
  location: 'San Antonio, TX',
  service: 'Home Theater Client — Nearly 10 Years',
  quote: "I've been a customer of KZ Audio for going on a decade. Kelly and crew have always been great to work with. They're honest and will recommend what actually works for your situation rather than upselling you on equipment you don't need. I've never had a bad experience with them and would absolutely recommend them to anyone looking for AV services.",
};
---

<BaseLayout
  title="Home Theater Installation Fair Oaks Ranch TX | KZ Audio & Video"
  description="Custom home theater and AV installation in Fair Oaks Ranch TX. KZ Audio & Video serves Bexar and Comal counties and the northwest San Antonio corridor. Call (210) 981-4098."
  schema={[schema, breadcrumb]}
>

  <HeroSection
    overline="Home Theater Installation · Fair Oaks Ranch · Bexar & Comal County · Since 2001"
    heading="Home Theater Installation in Fair Oaks Ranch, TX"
    subhead="KZ Audio & Video installs custom home theaters, whole-house audio, and outdoor AV in Fair Oaks Ranch. Sitting at the Bexar-Comal county line, Fair Oaks Ranch is home to some of the most impressive custom builds in the greater San Antonio area — and the AV systems to match. In the audio business since 1997."
    ctaLabel="Book a Free Consultation"
    ctaHref="/contact-kz-audio-video-san-antonio-tx/"
    secondaryCta="Or call: (210) 981-4098"
    secondaryHref="tel:2109814098"
    imageSrc="/images/projects/monty-theater/Home-Theater-Design-Build-Near-San-Antonio-Texas.jpeg.jpg"
    imageAlt="Custom home theater installation in Fair Oaks Ranch Texas"
  />

  <TrustBar />

  <ServicesGrid
    intro="KZ Audio & Video serves Fair Oaks Ranch and the surrounding Bexar-Comal county corridor. We design, install, and service custom home AV systems — no third-party labor."
  />

  <ProjectsGrid
    projects={projects}
    overline="Recent Projects"
    heading="Home Theater Installs Near Fair Oaks Ranch"
  />

  <TestimonialsSection featured={featured} />

  <!-- Why KZ -->
  <section class="section bg-charcoal">
    <div class="container-main">
      <p class="overline mb-3">Why KZ Audio & Video</p>
      <h2 class="font-display text-h2 text-warm-white mb-10">
        Fair Oaks Ranch Builds Right. The AV Should Too.
      </h2>
      <p class="text-body text-stone mb-10 max-w-3xl">
        Fair Oaks Ranch sits northwest of San Antonio near Boerne — a city of large-acreage custom properties, gated communities, and homes built without compromise. The clients here want dedicated theater rooms done properly: real projectors, real screens, real calibration. They want outdoor speakers that reach the pool and the fire pit. They want whole-house audio that actually covers the whole house. That's exactly what we build.
      </p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {[
          {
            title: 'Acreage Property Specialists',
            desc: "Large homes on large lots require different planning — longer cable runs, outdoor zones, whole-property audio coverage. We've done it across the Hill Country and we bring that experience to Fair Oaks Ranch.",
          },
          {
            title: 'New Construction Pre-Wire',
            desc: 'Fair Oaks Ranch sees significant custom home construction. We work with builders on pre-wire, rough-in, and trim-out — from the frame through the homeowner walkthrough.',
          },
          {
            title: 'Free In-Home Consultation',
            desc: 'We come to your property in Fair Oaks Ranch and design a system around the actual space. No charge, no obligation.',
          },
        ].map(({ title, desc }) => (
          <div class="flex flex-col gap-3">
            <h3 class="font-sans font-semibold text-h4 text-warm-white">{title}</h3>
            <p class="text-body text-stone">{desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CTASection
    heading="Ready to Get Started in Fair Oaks Ranch?"
    body="Book a free consultation. We'll come to your home in Fair Oaks Ranch and talk through what's possible for your space and your budget."
    ctaLabel="Book a Free Consultation"
    ctaHref="/contact-kz-audio-video-san-antonio-tx/"
    secondaryLabel="Call (210) 981-4098"
    secondaryHref="tel:2109814098"
  />

</BaseLayout>
