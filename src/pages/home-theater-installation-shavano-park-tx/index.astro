---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroSection from '../../components/sections/HeroSection.astro';
import TrustBar from '../../components/sections/TrustBar.astro';
import ServicesGrid from '../../components/sections/ServicesGrid.astro';
import ProjectsGrid from '../../components/sections/ProjectsGrid.astro';
import TestimonialsSection from '../../components/sections/TestimonialsSection.astro';
import CTASection from '../../components/sections/CTASection.astro';

const schema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Home Theater Installation Shavano Park",
  "provider": {
    "@type": "LocalBusiness",
    "name": "KZ Audio & Video",
    "url": "https://kzaudioandvideo.com",
    "telephone": "+12109814098"
  },
  "areaServed": "Shavano Park, TX",
  "description": "Custom home theater and AV installation in Shavano Park TX. KZ Audio & Video serves this northwest San Antonio enclave and surrounding neighborhoods.",
  "url": "https://kzaudioandvideo.com/home-theater-installation-shavano-park-tx/"
};

const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://kzaudioandvideo.com" },
    { "@type": "ListItem", "position": 2, "name": "Home Theater Installation Shavano Park TX" }
  ]
};

const projects = [
  {
    title: 'Dedicated Home Theater: Canyon Lake TX',
    location: 'Canyon Lake, TX',
    service: 'Home Theater',
    description: 'Full theater room with custom leather power recliner seating, blue LED accent lighting, projection system, and in-wall surround sound.',
    imageSrc: '/images/projects/monty-theater/Home-Theater-Near-San-Antonio-Texas.jpeg.jpg',
    imageAlt: 'Custom home theater with leather recliners and blue LED lighting near San Antonio Texas',
  },
  {
    title: 'Dedicated Home Theater: San Antonio TX',
    location: 'San Antonio, TX',
    service: 'Home Theater',
    description: 'Epson projector, Screen Innovations fixed-frame screen, Martin Logan on-wall speakers, LED accent lighting.',
    imageSrc: '/images/projects/asanka-theater/home-theater-led-lights-san-antonio.jpg',
    imageAlt: 'Home theater installation in San Antonio Texas with LED accent lighting and projection screen',
  },
];

const featured = {
  name: 'San Antonio Homeowner',
  location: 'San Antonio, TX',
  service: 'Home Theater Client: Nearly 10 Years',
  quote: "I've been a customer of KZ Audio for going on a decade. Kelly and crew have always been great to work with. They're honest and will recommend what actually works for your situation rather than upselling you on equipment you don't need. I've never had a bad experience with them and would absolutely recommend them to anyone looking for AV services.",
};
---

<BaseLayout
  title="Home Theater Installation Shavano Park TX | KZ Audio & Video"
  description="Custom home theater installation in Shavano Park TX. Dedicated theaters, surround sound, and whole-house audio in this NW SA enclave. Call (210) 981-4098."
  schema={[schema, breadcrumb]}
>

  <HeroSection
    overline="Home Theater Installation · Shavano Park · Northwest San Antonio · Since 1999"
    heading="Home Theater Installation in Shavano Park, TX"
    subhead="KZ Audio & Video designs and installs custom home theaters, whole-house audio, and outdoor AV in Shavano Park and northwest San Antonio. Large custom homes, private lots, dedicated theater rooms. This is what we do. In the audio business since 1999."
    ctaLabel="Book a Free Consultation"
    ctaHref="/contact-kz-audio-video-san-antonio-tx/"
    secondaryCta="Or call: (210) 981-4098"
    secondaryHref="tel:2109814098"
    imageSrc="/images/projects/monty-theater/Home-Theater-Design-Build-Near-San-Antonio-Texas.jpeg.jpg"
    imageAlt="Custom home theater installation in Shavano Park northwest San Antonio Texas"
  />

  <TrustBar />

  <ServicesGrid
    intro="KZ Audio & Video serves Shavano Park and northwest San Antonio. We design, install, and service custom home AV systems, no third-party labor."
  />

  <ProjectsGrid
    projects={projects}
    overline="Recent Projects"
    heading="Home Theater Installs Near Shavano Park"
  />

  <TestimonialsSection featured={featured} />

  <!-- Why KZ -->
  <section class="section bg-charcoal">
    <div class="container-main">
      <p class="overline mb-3">Why KZ Audio & Video</p>
      <h2 class="font-display text-h2 text-warm-white mb-10">
        Shavano Park Custom Homes Deserve Custom AV
      </h2>
      <p class="text-body text-stone mb-10 max-w-3xl">
        Shavano Park is a small, affluent municipality in northwest San Antonio: characterized by large lots, custom homes, and properties built for the way high-end San Antonio families actually live. Many homes here already have dedicated media rooms or bonus rooms that were pre-wired but never finished right. We spec and install systems that match the scale of the home: proper projectors, fixed-frame screens, in-ceiling Dolby Atmos speaker arrays, and whole-house audio that runs to the patio.
      </p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {[
          {
            title: 'Built for Larger Homes',
            desc: "Shavano Park homes tend to be 3,000–6,000+ square feet. We design systems that cover the space: whole-house audio, theater rooms, outdoor speakers, not systems that work in apartments.",
          },
          {
            title: 'New Construction Experience',
            desc: "We work with custom builders throughout northwest San Antonio. If you're building in Shavano Park, we're the pre-wire and AV call your builder should be making.",
          },
          {
            title: 'Free In-Home Consultation',
            desc: 'We come to your home in Shavano Park, look at the space, and give you an honest quote. No charge, no pressure.',
          },
        ].map(({ title, desc }) => (
          <div class="flex flex-col gap-3">
            <h3 class="font-sans font-semibold text-h4 text-warm-white">{title}</h3>
            <p class="text-body text-stone">{desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CTASection
    heading="Ready to Get Started in Shavano Park?"
    body="Book a free consultation. We'll come to your home in Shavano Park and design a system that fits the space."
    ctaLabel="Book a Free Consultation"
    ctaHref="/contact-kz-audio-video-san-antonio-tx/"
    secondaryLabel="Call (210) 981-4098"
    secondaryHref="tel:2109814098"
  />

</BaseLayout>
