---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroSection from '../../components/sections/HeroSection.astro';
import TrustBar from '../../components/sections/TrustBar.astro';
import FAQAccordion from '../../components/sections/FAQAccordion.astro';
import CTASection from '../../components/sections/CTASection.astro';

const schema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Home Theater Installation Jourdanton TX",
  "provider": {
    "@type": "LocalBusiness",
    "@id": "https://kzaudioandvideo.com/#business",
    "name": "KZ Audio & Video",
    "url": "https://kzaudioandvideo.com",
    "telephone": "+12109814098"
  },
  "areaServed": "Jourdanton, TX",
  "serviceType": "Home Theater Installation",
  "url": "https://kzaudioandvideo.com/home-theater-installation-jourdanton-tx/"
};

const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://kzaudioandvideo.com" },
    { "@type": "ListItem", "position": 2, "name": "Home Theater Installation Jourdanton TX" }
  ]
};

const faqs = [
  {
    question: "Do you make the drive to Jourdanton for consultations?",
    answer: "Yes. We serve Jourdanton and all of Atascosa County. The consultation is free — we come to your home, look at the space, discuss what you want, and give you a real number. No charge for the drive, no obligation after. Most of the homeowners we work with in the area are 45–60 minutes from San Antonio, and we make that drive regularly.",
  },
  {
    question: "What does a home theater installation in Jourdanton typically include?",
    answer: "It depends on the space and what you want. A dedicated theater room in a custom home on acreage typically includes a 4K projector, 120\"–135\" fixed-frame or motorized screen, 7.1 or 9.1 Atmos surround sound with in-wall speakers, acoustic treatment, and a control system. A media room conversion — taking an existing room and making it significantly better — might involve a large-screen TV, a soundbar upgrade to a real surround system, and blackout shades. We design around your space and your goals.",
  },
  {
    question: "Do you also install outdoor speakers and whole-house audio in Jourdanton?",
    answer: "Yes. Many of the properties we work on in Atascosa County are custom homes on large acreage, and whole-house audio and outdoor entertainment systems are common additions alongside the home theater. We design the entire AV system for the property — indoor zones, outdoor zones, home theater, and control system — as one integrated project or in phases depending on budget and timing.",
  },
  {
    question: "What brands do you install for home theater in Jourdanton?",
    answer: "We install equipment from Epson, Sony, and JVC for projection; Screen Innovations for screens; Martin Logan, Klipsch, and Polk for speakers; Denon, Marantz, and Anthem for AV receivers; Sonos for whole-house audio; and Lutron for lighting control. We're not tied to one brand — we recommend what's right for the space and budget.",
  },
  {
    question: "Can you pre-wire a new construction home in Jourdanton before the walls close?",
    answer: "Yes — and if you're building a custom home in Atascosa County right now, calling us before the drywall goes up is the ideal time. Pre-wire rough-in is significantly less expensive than retrofitting after the fact, and it gives you clean in-wall speaker runs, hidden cable paths, and equipment location planning built into the structure. We work directly with your builder or GC.",
  },
  {
    question: "How is the service area around Jourdanton — do you cover Pleasanton and Charlotte TX too?",
    answer: "Yes. We serve all of Atascosa County, including Pleasanton, Charlotte, and the surrounding area. If you're on a ranch property or custom home between Jourdanton and San Antonio on US-281, we come to you. The free consultation covers the drive.",
  },
];
---

<BaseLayout
  title="Home Theater Installation Jourdanton TX | KZ Audio & Video"
  description="Home theater and AV installation in Jourdanton TX and Atascosa County. Custom builds on acreage properties, pre-wire for new construction. In the business since 1997. Call (210) 981-4098."
  schema={[schema, breadcrumb]}
>

  <HeroSection
    overline="Home Theater Installation · Jourdanton TX · Atascosa County · Since 1997"
    heading="Home Theater Installation in Jourdanton, TX"
    subhead="KZ Audio & Video serves Jourdanton and Atascosa County. Custom home theater, whole-house audio, and outdoor AV for ranch properties and custom homes on acreage — designed and installed by the same team that's been doing this in South Texas since 1997. We come to you."
    ctaLabel="Book a Free Consultation"
    ctaHref="/contact-kz-audio-video-san-antonio-tx/"
    secondaryCta="Or call: (210) 981-4098"
    secondaryHref="tel:2109814098"
    imageSrc="/images/projects/asanka-theater/theater-room-san-antonio-tx.jpg"
    imageAlt="Custom home theater installation in Jourdanton Texas Atascosa County"
  />

  <TrustBar />

  <!-- Local Context -->
  <section class="section bg-charcoal">
    <div class="container-main">
      <p class="overline mb-3 reveal">Serving Atascosa County</p>
      <h2 class="font-display text-h2 text-warm-white mb-8 reveal reveal-delay-1">
        Jourdanton Homeowners Shouldn't Have to Drive to San Antonio for AV
      </h2>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
        <div>
          <p class="text-body-lg text-stone mb-6 reveal reveal-delay-2">
            Jourdanton is about 60 miles south of San Antonio on US-281 — Atascosa County seat, and the center of a region that's seen significant custom home construction on large acreage properties over the past decade. The Eagle Ford Shale play brought serious investment to this part of South Texas, and with it came custom builds that deserve a custom AV approach. Ranching families who've been here for generations are building new homes or upgrading existing ones with the same expectation.
          </p>
          <p class="text-body text-stone mb-6 reveal reveal-delay-3">
            Most Jourdanton homeowners who want quality AV work end up driving to San Antonio to find it — or settling for whoever happens to be available locally. KZ Audio &amp; Video makes the trip to Atascosa County. The consultation is free. We look at your space, discuss what you want, and give you a real number. You don't have to drive anywhere.
          </p>
          <p class="text-body text-stone reveal reveal-delay-4">
            We also serve Pleasanton, Charlotte, and the surrounding Atascosa County area. If you're on a property between Jourdanton and the Bexar County line, we're your team.
          </p>
        </div>
        <div class="flex flex-col gap-6">
          <div class="reveal reveal-delay-2">
            <h3 class="font-sans font-semibold text-warm-white mb-2">Custom Homes on Acreage</h3>
            <p class="text-body-sm text-stone">Large properties give you the space for dedicated theater rooms, whole-property audio zones, and outdoor entertainment systems that work at real scale. We design AV for properties where the distances between zones actually matter.</p>
          </div>
          <div class="reveal reveal-delay-3">
            <h3 class="font-sans font-semibold text-warm-white mb-2">New Construction Pre-Wire</h3>
            <p class="text-body-sm text-stone">Building a custom home in Atascosa County? Pre-wire is significantly less expensive before drywall closes. Call us early in the construction process and we coordinate directly with your builder. In-wall speakers, hidden cable runs, equipment room — all planned from the start.</p>
          </div>
          <div class="reveal reveal-delay-4">
            <h3 class="font-sans font-semibold text-warm-white mb-2">One Team, Every Install</h3>
            <p class="text-body-sm text-stone">Kelly, Billy, and Julian do every installation. No subcontractors. The same people who design the system build it. That matters on complex installs in custom homes — and it's how we've operated since 1997.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Services -->
  <section class="section bg-slate-surface">
    <div class="container-main">
      <p class="overline mb-3 reveal">What We Install in Jourdanton</p>
      <h2 class="font-display text-h2 text-warm-white mb-10 reveal reveal-delay-1">
        Full-Service AV for Atascosa County Properties
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {[
          {
            title: "Dedicated Home Theater Rooms",
            desc: "4K projection systems, fixed or motorized screens, 7.1 or Atmos surround sound, acoustic treatment, and seating layout — designed for a purpose-built theater room in a custom home.",
          },
          {
            title: "Media Room Upgrades",
            desc: "Not every home has a dedicated theater room. We upgrade existing living rooms and bonus rooms with large-screen displays, real surround sound systems, and clean wire management.",
          },
          {
            title: "Whole-House Audio",
            desc: "Multi-zone audio throughout the home — living areas, bedrooms, covered porches, and outdoor zones. Sonos-based or custom distribution systems depending on the property size and scope.",
          },
          {
            title: "Outdoor Entertainment",
            desc: "Patio speakers, pool deck audio, outdoor TVs, and projector systems for covered porches and outdoor living areas. Weatherproof equipment rated for South Texas heat and humidity.",
          },
          {
            title: "Surround Sound Installation",
            desc: "In-wall and in-ceiling speaker installation for living rooms and media spaces. From a clean 5.1 setup to full Dolby Atmos height channels — designed for the room you have.",
          },
          {
            title: "Pre-Wire & New Construction",
            desc: "Rough-in speaker wire, HDMI runs, low-voltage conduit, and equipment room planning during construction. The most cost-effective time to get this done right.",
          },
        ].map(({ title, desc }) => (
          <div class="card p-7 flex flex-col gap-3">
            <h3 class="font-sans font-semibold text-h4 text-warm-white">{title}</h3>
            <p class="text-body-sm text-stone leading-relaxed">{desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Why KZ -->
  <section class="section bg-charcoal">
    <div class="container-main">
      <p class="overline mb-3 reveal">Why KZ Audio &amp; Video</p>
      <h2 class="font-display text-h2 text-warm-white mb-8 reveal reveal-delay-1">
        In the Business Since 1997. Still the Same Team.
      </h2>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
        <div>
          <p class="text-body-lg text-stone mb-6 reveal reveal-delay-2">
            KZ Audio &amp; Video has been installing home AV systems in the San Antonio area since 1997. That's not a marketing claim — it means we've installed in virtually every type of home construction, dealt with every configuration problem that exists, and developed strong opinions about what equipment actually holds up and what doesn't. We don't learn on your project.
          </p>
          <p class="text-body text-stone reveal reveal-delay-3">
            We carry a 5.0 Google rating. The reviews aren't from one good year — they're from homeowners who've worked with us on complex installs and came back to say so. For homeowners in Jourdanton and Atascosa County, that matters: you're trusting a crew to spend a day or two in your home installing something that needs to work reliably for years. That's the job we show up to do.
          </p>
        </div>
        <div class="flex flex-col gap-5">
          <div class="reveal reveal-delay-2">
            <h3 class="font-sans font-semibold text-warm-white mb-1">Founded 1997</h3>
            <p class="text-body-sm text-stone">Nearly three decades in the San Antonio AV market. We've seen technologies come and go and know what's worth investing in.</p>
          </div>
          <div class="reveal reveal-delay-3">
            <h3 class="font-sans font-semibold text-warm-white mb-1">5.0 Google Rating</h3>
            <p class="text-body-sm text-stone">Consistent rating across every review. Not because installs are simple — because we do them right and stand behind the work.</p>
          </div>
          <div class="reveal reveal-delay-4">
            <h3 class="font-sans font-semibold text-warm-white mb-1">No Subcontractors</h3>
            <p class="text-body-sm text-stone">Kelly, Billy, and Julian. That's it. The same people every time, on every install, from the consultation through the final walkthrough.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <FAQAccordion
    heading="Home Theater Installation in Jourdanton TX — FAQ"
    faqs={faqs}
  />

  <CTASection
    heading="Ready to Get Started in Jourdanton?"
    body="Book a free, no-pressure consultation. We come to your property in Jourdanton or anywhere in Atascosa County, look at the space, and give you a real plan and real number."
    ctaLabel="Book a Free Consultation"
    ctaHref="/contact-kz-audio-video-san-antonio-tx/"
    secondaryLabel="Call (210) 981-4098"
    secondaryHref="tel:2109814098"
  />

</BaseLayout>
