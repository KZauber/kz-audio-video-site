---
import BaseLayout from "../../layouts/BaseLayout.astro";
import TrustBar from "../../components/sections/TrustBar.astro";
import FAQAccordion from "../../components/sections/FAQAccordion.astro";
import CTASection from "../../components/sections/CTASection.astro";

const faqPageSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How much does a home theater installation cost in San Antonio?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Home theater costs vary based on scope. A mid-tier dedicated theater room typically runs $15,000-$40,000 installed. High-end theaters with laser projectors, Dolby Atmos, and motorized seating run $40,000-$80,000+. A media room conversion can be done for $5,000-$12,000. We give you a detailed quote after seeing the space."
      }
    },
    {
      "@type": "Question",
      "name": "Do you handle the pre-wire and the finish work, or just one?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "We handle the full project: pre-wire, equipment selection, finish installation, calibration, and the homeowner walkthrough. We work with your builder during new construction or handle the retrofit ourselves in existing homes."
      }
    },
    {
      "@type": "Question",
      "name": "What projector brands do you install?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "We install Epson, Sony, BenQ, and JVC 4K projectors depending on room size, ambient light, and budget. For high-end dedicated theaters, Sony laser projectors deliver exceptional image quality. We match the projector to your room."
      }
    },
    {
      "@type": "Question",
      "name": "Can you build a theater in a room that is already finished?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Retrofit installs in finished rooms require fishing wire through walls and ceilings. We have done hundreds of these. Drywall impact is minimal. We will assess the specific room and tell you exactly what is involved before we start."
      }
    },
    {
      "@type": "Question",
      "name": "What is Dolby Atmos and do I need it?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Dolby Atmos adds overhead sound channels so audio moves three-dimensionally around the room. For a dedicated room we typically recommend it. For a living room media setup, a standard 5.1 or 7.1 system often makes more practical sense. We give you an honest recommendation based on your space."
      }
    },
    {
      "@type": "Question",
      "name": "How long does a home theater installation take?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "A full dedicated theater room typically takes two to four days after rough-in. A media room conversion is usually one to two days. We give you a timeline before we start and stick to it."
      }
    },
    {
      "@type": "Question",
      "name": "What is a whole house audio system?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "A whole house audio system lets you play music in multiple rooms — independently or all at once — controlled from your phone, a wall keypad, or a voice assistant. You might have Sonos in the kitchen and living room, in-ceiling speakers on the patio, and a dedicated amp for the master bedroom. Each zone can play something different, or you can group them together."
      }
    },
    {
      "@type": "Question",
      "name": "What brands do you install for whole house audio?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "We install Sonos, Denon HEOS, Klipsch, Polk Audio, Niles, and Dayton in-ceiling and in-wall speakers depending on what the room calls for. We match the equipment to the use case — whether that is a simple Sonos system in an existing home or a whole-house wired multi-zone setup in new construction."
      }
    },
    {
      "@type": "Question",
      "name": "Can I add audio to my existing home without major construction?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Often yes. Sonos and similar wireless systems can be added to an existing home with minimal disruption. In-ceiling speakers in finished spaces sometimes require fishing wire through walls — we are experienced with that and minimize any drywall impact. We will assess what is realistic in your home and tell you upfront."
      }
    },
    {
      "@type": "Question",
      "name": "How many zones do I need?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Most residential installs run two to six zones — kitchen, living room, master bedroom, patio, pool area, garage. We design around how you actually move through your home and where music makes your life better. There is no up-sell to zones you will never use."
      }
    },
    {
      "@type": "Question",
      "name": "Can I control everything from my phone?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Modern whole house audio systems — particularly Sonos — are built around phone control. You can play, pause, switch sources, adjust volume by room, and group zones together from your iOS or Android device. We also install wall keypads if you want dedicated controls in specific rooms."
      }
    },
    {
      "@type": "Question",
      "name": "What kind of outdoor AV systems do you install?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "We install weatherproof speaker systems, outdoor TVs, and outdoor projector setups for covered patios, pool decks, outdoor kitchens, and backyards. We design around how the space is used — a patio that is primarily for music needs a different solution than a covered outdoor theater. We will tell you what holds up in the Texas heat and humidity."
      }
    },
    {
      "@type": "Question",
      "name": "Do outdoor speakers hold up in the San Antonio climate?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The right ones do. We install speakers rated for outdoor use — weather-sealed enclosures, UV-resistant drivers, stainless hardware. The Texas heat and humidity is real, and we spec equipment that is designed for it. We have had outdoor installs running reliably for years in this climate."
      }
    },
    {
      "@type": "Question",
      "name": "Can I add an outdoor TV to my covered patio?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. We install weatherproof and partial-sun rated outdoor TVs and mount them clean with no visible wiring. We assess the sun exposure, ambient light, and mounting surface and recommend the right display for the location. Not every TV marketed as outdoor is built for direct Texas sun — we know the difference."
      }
    },
    {
      "@type": "Question",
      "name": "What about an outdoor projector for movie nights?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "A covered patio or outdoor theater setup is one of our favorite installs. We ceiling-mount the projector under the cover, run the wire clean through the structure, and pair it with a motorized or fixed-frame screen and outdoor speakers. The result is a proper movie experience outside."
      }
    },
    {
      "@type": "Question",
      "name": "Can my outdoor speakers connect to my whole house audio system?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Absolutely — and that is usually the best approach. Your patio and backyard become one or more zones in your whole-house system, controlled the same way as every other room. If you already have a Sonos system inside, we add to it. If you are starting fresh, we design it all together."
      }
    },
    {
      "@type": "Question",
      "name": "Do you offer free consultations?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. We offer free in-home consultations across San Antonio and the Hill Country. We come to you, assess the space, and put together a system designed for that specific room. No pressure, no obligation."
      }
    },
    {
      "@type": "Question",
      "name": "What areas do you serve?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "We serve San Antonio and the surrounding Texas Hill Country — including Boerne, Canyon Lake, Helotes, Bulverde, Stone Oak, and New Braunfels. We have been working with homeowners and custom builders in this region since 1997."
      }
    },
    {
      "@type": "Question",
      "name": "Do you work on new construction and existing homes?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Both. We work with custom home builders during new construction — handling pre-wire, rough-in, trim-out, programming, and the homeowner walkthrough. For existing homes we do full retrofit installs. We have nine active builder relationships, the longest running since 2009."
      }
    },
    {
      "@type": "Question",
      "name": "What is the difference between a media room and a dedicated home theater?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "A media room is a multipurpose space — a bonus room or living room set up for better TV and audio, used for gaming, sports, and casual watching. A dedicated home theater is a purpose-built room designed around projection, surround sound, acoustic treatment, and controlled lighting. Dedicated theaters start around $15,000 and go up from there. Media room upgrades can be done for $3,000–$10,000. Which one makes sense depends on your space, how you use it, and your budget. We help you figure that out in the free consultation."
      }
    },
    {
      "@type": "Question",
      "name": "Should I get a projector or a TV for my home theater?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "For a dedicated theater room, a projector almost always wins — you get a 100–150 inch image that a TV simply cannot match at any price. For a living room or media room where you can't control ambient light, a large-format TV (85–98 inch) is often more practical. The decision comes down to room size, how much you can darken the space, and viewing distance. KZ Audio & Video installs both — Epson, Sony, JVC, and BenQ projectors, plus Samsung, LG, and Sony TVs including the Samsung Frame. We'll tell you which one is right for your specific room."
      }
    },
    {
      "@type": "Question",
      "name": "How much does a whole house audio system cost in San Antonio?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "A basic whole house audio system — two to three zones with Sonos and in-ceiling speakers — typically runs $2,500–$6,000 installed in San Antonio. A mid-range system with four to six zones, wired in-ceiling speakers, and a dedicated amplifier runs $6,000–$15,000. Full custom multi-zone systems in new construction with keypads, outdoor zones, and whole-home integration can run $15,000–$30,000+. The largest variable is how many zones you need and whether the home is new construction (pre-wire is cheap) or an existing home (retrofit costs more). We quote by zone after seeing the home."
      }
    },
    {
      "@type": "Question",
      "name": "What is the difference between 5.1, 7.1, and Dolby Atmos surround sound?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "5.1 surround sound means five speakers plus a subwoofer — left, center, right up front, and two surround speakers behind or beside you. 7.1 adds two additional surround channels for a wider soundstage. Dolby Atmos builds on either of those configurations by adding height channels — speakers in the ceiling or angled upward from the front and rear — so sound moves vertically as well as horizontally. For a dedicated theater room, Dolby Atmos is worth the investment. For a living room or bonus room with furniture constraints, a well-calibrated 5.1 system often sounds better than a poorly placed 7.1. KZ Audio & Video recommends what actually works in your room."
      }
    },
    {
      "@type": "Question",
      "name": "Do I need acoustic treatment in my home theater?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "For a dedicated theater room, yes — acoustic treatment makes a significant difference. Hard surfaces like drywall, hardwood floors, and glass reflect sound and create echo that muddies dialogue and degrades the surround experience. Acoustic panels, bass traps, and carpet absorb and diffuse those reflections. In most dedicated theater installs we recommend at minimum: carpet or rugs, upholstered seating, and fabric wall panels on the side walls. Full acoustic treatment is not always necessary — proper speaker placement and calibration can compensate for a lot. We assess the room acoustics during the consultation and tell you exactly what will move the needle."
      }
    },
    {
      "@type": "Question",
      "name": "Can you install a Samsung Frame TV with hidden wiring?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes — and we do a lot of them in San Antonio. The Samsung Frame TV is designed to look like art when not in use, which means the wiring has to be completely hidden or the effect is ruined. We fish the power and HDMI through the wall, route the One Connect box into a nearby cabinet or media console, and leave zero visible cables. On stone or brick fireplace walls — common in Hill Country homes — we route wiring through the structure itself. We have mounted Frame TVs on drywall, marble, limestone, and brick. The result is a clean, frameless look that holds up."
      }
    },
    {
      "@type": "Question",
      "name": "Do you source the equipment or do I buy it myself?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "We source all equipment as part of the project. You don't need to buy anything before we start. We spec the right gear for your room and budget, order it, and install it. This matters because equipment compatibility is complicated — the wrong projector for the throw distance, the wrong amplifier for the speaker impedance, the wrong receiver for the HDMI version — these are real problems we see when clients pre-buy from Amazon or Best Buy. If you already own equipment you want to keep or incorporate, we work with it. But we don't require you to shop before the consultation."
      }
    },
    {
      "@type": "Question",
      "name": "What happens if something stops working after the installation?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "We answer the phone. That's not a marketing line — it's been our operating model since 2001. If a system we installed has an issue, we come back and fix it. Equipment manufacturer defects are handled through the warranty process; wiring, programming, and installation issues are on us. We have clients who have been with us for nearly a decade — that only works if we're there when something goes wrong. We also repair AV systems we didn't install. If you're dealing with a system from a previous installer or a system you set up yourself, call us at (210) 981-4098."
      }
    },
    {
      "@type": "Question",
      "name": "What makes KZ Audio & Video different from other AV companies in San Antonio?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Three things that are unusual in this market. First, we have been doing this since 1997 — Kelly Zauber started Audio Outlet that year and has been in home AV since 2001. That's 25+ years of experience in this specific region. Second, we use no subcontractors. Kelly, Billy, and Julian do every install personally. Third, we don't upsell. Our longest client relationship is nearly a decade because we recommend what actually works for the budget and the room, not what generates the highest margin. For builders, we have nine active partnerships — the longest since 2009 — because we show up on schedule and don't create problems on job sites."
      }
    },
    {
      "@type": "Question",
      "name": "Who are the best home theater installers in San Antonio?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "KZ Audio & Video is one of San Antonio's most experienced residential AV companies, in business since 1997 with a 5.0 Google rating. Kelly Zauber and his team — Billy and Julian — personally install every system with no subcontractors. They serve San Antonio and the Texas Hill Country including Boerne, Canyon Lake, Bulverde, Helotes, Stone Oak, Timberwood Park, and New Braunfels. Other established San Antonio AV companies include Bjorn's, TSGSAN, and Alamo Smart Home. KZ Audio & Video is particularly well-regarded for high-end dedicated theater rooms, whole house audio, and new construction AV work through builder partnerships. Free in-home consultations available at (210) 981-4098."
      }
    }
  ]
};

