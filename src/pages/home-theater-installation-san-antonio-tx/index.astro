---
import BaseLayout from "../../layouts/BaseLayout.astro";
import HeroSection from "../../components/sections/HeroSection.astro";
import TrustBar from "../../components/sections/TrustBar.astro";
import ProjectsGrid from "../../components/sections/ProjectsGrid.astro";
import TestimonialsSection from "../../components/sections/TestimonialsSection.astro";
import FAQAccordion from "../../components/sections/FAQAccordion.astro";
import CTASection from "../../components/sections/CTASection.astro";
import LowVoltageFirst from "../../components/sections/LowVoltageFirst.astro";
import { REVIEWS_SENTENCE } from "../../data/business";
import { BRANDE_SCHRIEWER, DENNIS_GARRETT, MONTY_HEINS } from "../../data/reviews";

const schema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Home Theater Installation San Antonio TX",
  "provider": {
    "@type": "LocalBusiness",
    "name": "KZ Audio & Video",
    "url": "https://kzaudioandvideo.com",
    "telephone": "+12109814098"
  },
  "areaServed": ["San Antonio", "Boerne", "Canyon Lake", "Helotes", "Bulverde", "Stone Oak", "New Braunfels"],
  "description": "Custom home theater design and installation in San Antonio TX and the Texas Hill Country. Dedicated theater rooms, 4K and laser projection, Dolby Atmos surround sound.",
  "url": "https://kzaudioandvideo.com/home-theater-installation-san-antonio-tx/"
};

const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://kzaudioandvideo.com" },
    { "@type": "ListItem", "position": 2, "name": "Home Theater Installation San Antonio TX" }
  ]
};

const projects = [
  {
    title: "Dedicated Home Theater: Canyon Lake TX",
    location: "Canyon Lake, TX",
    service: "Home Theater",
    description: "Full theater room with custom leather power recliner seating on a raised platform, blue LED accent lighting, 4K projection system, and in-wall Dolby Atmos surround sound.",
    imageSrc: "/images/projects/monty-theater/home-theater-near-san-antonio-hero.jpg",
    imageAlt: "Custom home theater with leather recliners and blue LED lighting in Canyon Lake Texas",
    href: "/projects/canyon-lake-dedicated-home-theater/",
  },
  {
    title: "Dedicated Home Theater: Stone Oak, San Antonio TX",
    location: "Stone Oak, San Antonio, TX",
    service: "Home Theater",
    description: "Epson projector, Screen Innovations fixed-frame screen, Martin Logan on-wall speakers, LED accent lighting. Pre-wire through finished install.",
    imageSrc: "/images/projects/asanka-theater/san-antonio-home-theater-project-cover.jpg",
    imageAlt: "Home theater installation Stone Oak San Antonio Texas with projection screen and surround sound",
    href: "/projects/stone-oak-home-theater-epson-martin-logan/",
  },
  {
    title: "Star Wars Home Theater: San Antonio TX",
    location: "San Antonio, TX",
    service: "Home Theater",
    description: "Custom built-in entertainment wall, fixed-frame projection screen, JVC projector, and complete Dolby Atmos surround system. Designed around the client's collection.",
    imageSrc: "/images/projects/davids-theater/san-antonio-home-theater-star-wars-theme-hero.jpg",
    imageAlt: "Custom Star Wars themed home theater San Antonio Texas",
    href: "/projects/star-wars-home-theater-san-antonio/",
  },
  {
    title: "New Construction Home Theater: Stone Oak TX",
    location: "Stone Oak, San Antonio, TX",
    service: "Home Theater",
    description: "New construction dedicated theater room. Full pre-wire, Epson projector, Martin Logan speakers, custom leather seating platform. Built from rough-in to final calibration.",
    imageSrc: "/images/projects/young-theater/stone-oak-home-theater-hero.jpg",
    imageAlt: "New construction home theater Stone Oak San Antonio TX with leather seating and projection screen",
    href: "/projects/stone-oak-new-construction-home-theater/",
  },
];

const featured = MONTY_HEINS;

const secondary = [DENNIS_GARRETT, BRANDE_SCHRIEWER];

const faqs = [
  {
    // A real search, relayed by Kelly 2026-11-05: "I want to build a hometheater in san antonio what is the best company". Spacing and punctuation only.
    question: "I want to build a home theater in San Antonio. What is the best company?",
    answer: "The best company for a home theater build is one that plans the room around the seats, runs the wiring before the walls close, installs with its own crew, and calibrates the finished system. KZ Audio & Video has built theaters that way across San Antonio and the Texas Hill Country since 1999. Ask any company you are considering to show you finished rooms, tell you who will run the wire, and put the quote in writing. Start with our free in-home consultation: we measure the room and give you a written quote. Call or text (210) 981-4098.",
  },
  {
    question: "How much does a home theater installation cost in San Antonio?",
    answer: "Home theater costs vary based on scope. At KZ Audio & Video, a mid-tier dedicated theater room typically runs $15,000-$40,000 installed. High-end theaters with laser projectors, Dolby Atmos, and motorized seating run $40,000-$80,000+. A media room conversion can be done for $10,000-$15,000. We give you a detailed quote after seeing the space. Call or text (210) 981-4098.",
  },
  {
    question: "Do you handle the pre-wire and the finish work, or just one?",
    answer: "We handle the full project: pre-wire, equipment selection, finish installation, calibration, and the homeowner walkthrough. We work with your builder during new construction or handle the retrofit ourselves in existing homes.",
  },
  {
    question: "What projector brands do you install?",
    answer: "We install Epson, Sony, BenQ, and JVC 4K projectors depending on room size, ambient light, and budget. For high-end dedicated theaters, Sony laser projectors deliver exceptional image quality. We match the projector to your room.",
  },
  {
    question: "Can you build a theater in a room that is already finished?",
    answer: "Yes. Retrofit installs in finished rooms require fishing wire through walls and ceilings. We have done hundreds of these. Drywall impact is minimal. We will assess the specific room and tell you exactly what is involved before we start.",
  },
  {
    question: "What is Dolby Atmos and do I need it?",
    answer: "Dolby Atmos adds overhead sound channels so audio moves three-dimensionally around the room. For a dedicated room we typically recommend it. For a living room media setup, a standard 5.1 or 7.1 system often makes more practical sense. We give you an honest recommendation based on your space.",
  },
  {
    question: "How long does a home theater installation take?",
    answer: "A full dedicated theater room typically takes two to four days after rough-in. A media room conversion is usually one to two days. We give you a timeline before we start and stick to it.",
  },
  // The next three are real Google "People also ask" questions, captured word for word
  // on 2026-10-16 (logged in the SocialMedia repo, kz/website/faq-source-log.md).
  {
    question: "Are home theater systems worth it?",
    answer: "For most families who watch movies or sports together every week, yes. The difference between TV speakers and a real surround system is something you hear on the first night, and a well-planned system gets used for years. It does not have to mean a $40,000 dedicated room. A media room built around your existing living space, with a large 4K display, a 5.1 or 7.1 surround system and hidden wiring, typically runs $10,000 to $15,000 in San Antonio. Surround sound added to a TV you already own runs about $3,000 to $5,000. Where people end up disappointed is buying equipment without designing for the room: speakers in the wrong places, a screen that is too small for the seats, or a room that echoes. If you are building a home, plan the theater at framing, when the wiring costs far less to run. We give you an honest recommendation, including when a simpler setup makes more sense.",
  },
  {
    question: "What is the ideal size room for a home theater?",
    answer: "For a dedicated theater, about 12 by 16 feet or larger works best. That size fits a tiered seating platform, a large projection screen and a full Dolby Atmos speaker layout, with every speaker where it belongs. The practical floor is roughly 10 by 12 feet: enough for a loveseat or two chairs, a 100-inch screen and proper speaker placement. Go smaller than that and the distance from the seats to the screen gets uncomfortable, and the surround speakers get hard to place. A small room is not a dead end, though. A short throw projector can put a 100 to 110 inch picture on the screen from just 4 to 6 feet away, which opens up bedrooms, bonus rooms and converted garages or attics. We have designed rooms at both ends of that range. On the free in-home consultation, we measure your room and tell you plainly what it can hold.",
  },
  {
    question: "What is the best setup for home theater?",
    answer: "The best setup is the one designed around your room, so it depends on the space. For a dedicated theater room, our usual recommendation is a 4K or laser projector on a fixed-frame screen, a Dolby Atmos speaker layout such as 7.2.4 with height speakers in the ceiling, in-wall or in-ceiling speakers so nothing clutters the room, a tiered seating platform and acoustic treatment, all on one remote. For a living room or media room that has to work in daylight, a large 4K display of 85 inches or more usually beats a projector, paired with a 5.1 or 7.1 surround system or a premium soundbar and the wiring hidden in the wall. What separates a great setup from an expensive disappointment is calibration and placement, not the price of the box. Every system we install is calibrated by the person who designed it, and we will tell you when a simpler setup is the better choice.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(({ question, answer }) => ({
    "@type": "Question",
    "name": question,
    "acceptedAnswer": { "@type": "Answer", "text": answer },
  })),
};
---

<BaseLayout
  title="Home Theater Installation San Antonio TX | KZ Audio & Video"
  description="Custom home theater installation in San Antonio TX. Dedicated theater rooms, 4K projection, Dolby Atmos, and media room conversions. Call (210) 981-4098."
  schema={[schema, breadcrumb, faqSchema]}
>

  <HeroSection
    heading="Custom Home Theater Installation in San Antonio TX"
    subhead="KZ Audio & Video designs and installs dedicated home theater rooms, media spaces, and projection systems across San Antonio and the Texas Hill Country."
    imageSrc="/images/projects/young-theater/stone-oak-home-theater-hero.jpg"
    imageAlt="Custom home theater installation Stone Oak San Antonio TX with leather seating and projection screen"
    compact={true}
  />

  <TrustBar />

  <!-- Self-contained answer, written to be quoted. Real search, Kelly 2026-11-05; prices match this page's FAQ. -->
  <section id="best-home-theater-company" class="section bg-charcoal">
    <div class="container-main">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
        <div class="lg:col-span-7">
          <p class="overline mb-3">The Short Answer</p>
          <h2 class="font-display text-h2 text-warm-white mb-6">What Is the Best Company to Build a Home Theater in San Antonio?</h2>
          <p class="text-body-lg text-stone leading-relaxed">
            The best company to build your home theater is one that plans the room around the seats, runs the low voltage before the walls close, installs with its own crew, and calibrates the picture and sound when it is done. KZ Audio & Video has built home theaters that way across San Antonio and the Texas Hill Country since 1999, rated {REVIEWS_SENTENCE}. We design dedicated theaters and media rooms with 4K and laser projectors, fixed-frame screens, Dolby Atmos layouts such as 7.2.4, seating, lighting and control. At KZ, a mid-tier dedicated theater typically runs $15,000 to $40,000 installed, and a media room conversion $10,000 to $15,000. In a new build, the wiring goes in first and the speakers, projector and screen go in after. Every project starts with a free in-home consultation: we measure the room, talk through how you will use it, and give you a written quote.
          </p>
        </div>
        <div class="lg:col-span-5 card p-7">
          <h3 class="font-sans font-semibold text-h4 text-warm-white mb-4">What to ask any company you are considering</h3>
          <ul class="flex flex-col gap-3">
            {[
              "Can I see finished rooms you built?",
              "Who runs the wire and who installs: your own crew or subcontractors?",
              "Do you calibrate the picture and the sound?",
              "Will I get an itemized written quote?",
            ].map((q) => (
              <li class="flex gap-3 text-body-sm text-stone leading-relaxed">
                <svg class="flex-shrink-0 mt-1 text-gold" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
                <span>{q}</span>
              </li>
            ))}
          </ul>
          <div class="mt-6 flex flex-wrap gap-x-6 gap-y-2">
            <a href="/home-theater-projects-san-antonio/" class="btn-text text-sm cursor-pointer">See our finished rooms &rarr;</a>
            <a href="/home-theater-guide/" class="btn-text text-sm cursor-pointer">Planning guide &rarr;</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-slate-surface">
    <div class="container-main">
      <p class="overline mb-3">Home Theater Design and Build</p>
      <h2 class="font-display text-h2 text-warm-white mb-6">
        Built Around Your Room. Designed for How You Watch.
      </h2>
      <p class="text-body-lg text-stone mb-12 max-w-2xl">
        Before we spec a single piece of equipment, we measure your room, assess the acoustics, and understand how you use the space. Then we design a system that sounds like it was built for that specific room, because it was.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
        <div>
          <h3 class="font-sans font-semibold text-h3 text-warm-white mb-5">Dedicated Theater Rooms</h3>
          <ul class="flex flex-col gap-3 mb-10">
            {[
              "4K and laser projection systems (Epson, Sony, BenQ, JVC)",
              "Fixed-frame and motorized projection screens",
              "Dolby Atmos 7.2.4 and 9.2.4 surround sound",
              "In-wall and in-ceiling speaker systems",
              "Custom tiered seating platforms",
              "LED bias and accent lighting control",
              "Acoustic treatment and room calibration",
              "Rack-mounted equipment with clean cable management",
              "Universal control systems (home control, RTI)",
            ].map((item) => (
              <li class="flex items-start gap-3 text-body text-stone">
                <span class="text-gold mt-1 flex-shrink-0">&rarr;</span>
                {item}
              </li>
            ))}
          </ul>

          <h3 class="font-sans font-semibold text-h3 text-warm-white mb-5">Media Room Conversions</h3>
          <ul class="flex flex-col gap-3">
            {[
              "Large-format 4K displays (85 to 110 inch) and micro LED walls (108 to 162 inch+)",
              "Soundbars and 5.1 and 7.1 surround upgrades",
              "Hidden wire and in-wall power solutions",
              "Streaming and source device integration",
              "Existing room retrofits with minimal disruption",
            ].map((item) => (
              <li class="flex items-start gap-3 text-body text-stone">
                <span class="text-gold mt-1 flex-shrink-0">&rarr;</span>
                {item}
              </li>
            ))}
          </ul>
          <p class="text-body text-stone leading-relaxed mt-8">
            More on each part: <a href="/surround-sound-installation-san-antonio/" class="text-gold hover:text-warm-white transition-colors underline underline-offset-2 cursor-pointer">surround sound installation</a>, <a href="/home-theater-room-conversion-san-antonio/" class="text-gold hover:text-warm-white transition-colors underline underline-offset-2 cursor-pointer">turning an existing room into a theater</a>, <a href="/micro-led-wall-san-antonio/" class="text-gold hover:text-warm-white transition-colors underline underline-offset-2 cursor-pointer">micro LED walls</a>, and <a href="/av-system-upgrade-san-antonio/" class="text-gold hover:text-warm-white transition-colors underline underline-offset-2 cursor-pointer">upgrading a system you already own</a>.
          </p>
        </div>

        <div class="flex flex-col gap-6">
          <div class="card p-7">
            <p class="overline mb-3">The KZ Difference</p>
            <h3 class="font-sans font-semibold text-h3 text-warm-white mb-4">The Same Team, Start to Finish.</h3>
            <p class="text-body text-stone mb-4">
              Every home theater we build is installed by Kelly, Billy, or Julian. We do not hand your project to a crew you have never met. Every system is calibrated by the person who designed it.
            </p>
            <p class="text-body text-stone">
              We have been doing this since 1999. We design around the problems that make theaters disappointing: rooms that echo, systems that feel unbalanced, equipment that will not integrate. Every decision starts with the room.
            </p>
          </div>

          <div class="card p-7">
            <p class="overline mb-3">New Construction</p>
            <h3 class="font-sans font-semibold text-h3 text-warm-white mb-4">Builder-Ready Pre-Wire</h3>
            <p class="text-body text-stone">
              We work with custom home builders throughout the Hill Country and San Antonio. Pre-wire, rough-in, trim-out, programming, and the homeowner walkthrough. Nine active builder relationships, the longest running since 2009.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <ProjectsGrid
    projects={projects}
    overline="Recent Theater Builds"
    heading="Home Theater Projects in San Antonio and the Hill Country"
  />

  <TestimonialsSection featured={featured} secondary={secondary} />

  <section class="section bg-slate-surface">
    <div class="container-main">
      <p class="overline mb-3">Investment Guide</p>
      <h2 class="font-display text-h2 text-warm-white mb-6">
        What Does a Home Theater Cost in San Antonio?
      </h2>
      <p class="text-body-lg text-stone mb-10 max-w-2xl">
        We give you a detailed quote after seeing the space. Call or text (210) 981-4098. Here is a realistic framework for budgeting.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {[
          {
            tier: "Media Room",
            range: "$10,000 to $15,000",
            desc: "Existing room, large 4K display, 5.1 surround or soundbar upgrade, streaming sources, hidden wiring. No construction required.",
          },
          {
            tier: "Mid-Tier Theater",
            range: "$15,000 to $40,000",
            desc: "4K projection, fixed-frame screen, 7.1 Dolby Atmos, in-wall speakers, tiered seating platform, acoustic treatment, full control system.",
          },
          {
            tier: "Premium Theater",
            range: "$40,000 to $80,000+",
            desc: "Laser projection, motorized screen, 9.2.4 Atmos, custom acoustics, motorized leather seating, full AV and lighting control.",
          },
        ].map(({ tier, range, desc }) => (
          <div class="card p-7">
            <p class="overline mb-2">{tier}</p>
            <p class="font-display text-h3 text-gold mb-4">{range}</p>
            <p class="text-body text-stone">{desc}</p>
          </div>
        ))}
      </div>
      <p class="text-body-sm text-ash mt-6">
        Prices are estimates for the San Antonio market. Final pricing depends on room size, materials, and equipment selection. We provide a written quote before any work begins.
      </p>
      <a href="/home-theater-cost-san-antonio/" class="inline-flex items-center gap-2 text-gold font-sans font-medium mt-6 cursor-pointer hover:text-warm-white transition-colors">
        Try our instant home theater cost calculator
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
    </div>
  </section>

  <FAQAccordion
    heading="Home Theater Installation: Frequently Asked Questions"
    faqs={faqs}
  />

  <LowVoltageFirst
    heading="Low Voltage First, Then the Theater"
    rough="Speaker wire for every channel, HDMI and network runs to the screen wall and the equipment rack, and projector power and signal, pulled and labeled while the walls are open."
    installs="We come back at trim and install the speakers, projector and screen, set up the rack, and calibrate every speaker to the seats."
    existing="Turning a room in a finished home into a theater? We run the same low voltage through the finished walls and ceiling first, then install."
  />

  <section class="section bg-charcoal">
    <div class="container-main text-center max-w-2xl mx-auto">
      <p class="overline mb-3">Instant Estimate</p>
      <h2 class="font-display text-h2 text-warm-white mb-4">Wondering What a Home Theater Costs?</h2>
      <p class="text-body-lg text-stone mb-8">
        Get a real ballpark for your setup in 30 seconds: pick your room size, display, and sound system. No form. No email. Just answers.
      </p>
      <a href="/home-theater-cost-san-antonio/" class="btn-primary gold-shimmer cursor-pointer">
        Use the Free Cost Calculator →
      </a>
      <p class="mt-6">
        <a href="/home-theater-guide/" class="btn-text cursor-pointer">Read the free Home Theater Planning Guide: seating, screen size, speaker types and wiring &rarr;</a>
      </p>
      <p class="mt-3">
        <a href="/guides/kz-home-theater-planning-guide.pdf" class="btn-text cursor-pointer">Or download the Home Theater Planning &amp; Budget Guide (PDF) &rarr;</a>
      </p>
    </div>
  </section>

  <CTASection
    heading="Let us Design Your Home Theater."
    body="Book a free in-home consultation. We come to you, assess the space, and put together a system designed for that specific room. No pressure. No obligation."
    ctaLabel="Book a Free Consultation"
    ctaHref="/contact-kz-audio-video-san-antonio-tx/"
    secondaryLabel="Call (210) 981-4098"
    secondaryHref="tel:2109814098"
    bgImage="/images/projects/monty-theater/Home-Theater-Design-Build-Near-San-Antonio-Texas.jpeg.jpg"
  />

</BaseLayout>
