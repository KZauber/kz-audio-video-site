---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroSection from '../../components/sections/HeroSection.astro';
import TrustBar from '../../components/sections/TrustBar.astro';
import ServicesGrid from '../../components/sections/ServicesGrid.astro';
import ProjectsGrid from '../../components/sections/ProjectsGrid.astro';
import TestimonialsSection from '../../components/sections/TestimonialsSection.astro';
import CTASection from '../../components/sections/CTASection.astro';

const schema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Home Theater Installation Alamo Heights",
  "provider": {
    "@type": "LocalBusiness",
    "name": "KZ Audio & Video",
    "url": "https://kzaudioandvideo.com",
    "telephone": "+12109814098"
  },
  "areaServed": "Alamo Heights, San Antonio, TX",
  "description": "Custom home theater and AV installation in Alamo Heights San Antonio TX. KZ Audio & Video serves 78209 and surrounding neighborhoods.",
  "url": "https://kzaudioandvideo.com/home-theater-installation-alamo-heights-san-antonio/"
};

const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://kzaudioandvideo.com" },
    { "@type": "ListItem", "position": 2, "name": "Home Theater Installation Alamo Heights San Antonio TX" }
  ]
};

const projects = [
  {
    title: 'Dedicated Home Theater: Canyon Lake TX',
    location: 'Canyon Lake, TX',
    service: 'Home Theater',
    description: 'Full theater room with custom leather power recliner seating, blue LED accent lighting, projection system, and in-wall surround sound.',
    imageSrc: '/images/projects/monty-theater/Home-Theater-Near-San-Antonio-Texas.jpeg.jpg',
    imageAlt: 'Custom home theater with leather recliners and blue LED lighting near San Antonio Texas',
  },
  {
    title: 'Dedicated Home Theater: San Antonio TX',
    location: 'San Antonio, TX',
    service: 'Home Theater',
    description: 'Epson projector, Screen Innovations fixed-frame screen, Martin Logan on-wall speakers, LED accent lighting.',
    imageSrc: '/images/projects/asanka-theater/home-theater-led-lights-san-antonio.jpg',
    imageAlt: 'Home theater installation in San Antonio Texas with LED accent lighting and projection screen',
  },
];

const featured = {
  name: 'San Antonio Homeowner',
  location: 'San Antonio, TX',
  service: 'Home Theater Client: Nearly 10 Years',
  quote: "I've been a customer of KZ Audio for going on a decade. Kelly and crew have always been great to work with. They're honest and will recommend what actually works for your situation rather than upselling you on equipment you don't need. I've never had a bad experience with them and would absolutely recommend them to anyone looking for AV services.",
};
---

<BaseLayout
  title="Home Theater Alamo Heights San Antonio | KZ Audio & Video"
  description="Custom home theater and AV installation in Alamo Heights, San Antonio TX. KZ Audio & Video serves 78209 and the surrounding neighborhoods. Call (210) 981-4098."
  schema={[schema, breadcrumb]}
>

  <HeroSection
    overline="Home Theater Installation · Alamo Heights · San Antonio · Since 1999"
    heading="Home Theater Installation in Alamo Heights, San Antonio TX"
    subhead="KZ Audio & Video installs custom home theaters, whole-house audio, and outdoor AV in Alamo Heights and the surrounding 78209 area. Whether it's a 1950s home on Broadway getting a modern media room or a renovated estate off Ogden, we design systems for the space. In the audio business since 1999."
    ctaLabel="Book a Free Consultation"
    ctaHref="/contact-kz-audio-video-san-antonio-tx/"
    secondaryCta="Or call: (210) 981-4098"
    secondaryHref="tel:2109814098"
    imageSrc="/images/projects/monty-theater/Home-Theater-Design-Build-Near-San-Antonio-Texas.jpeg.jpg"
    imageAlt="Custom home theater installation in Alamo Heights San Antonio Texas"
  />

  <TrustBar />

  <ServicesGrid
    intro="KZ Audio & Video serves Alamo Heights and the surrounding 78209 area. We design, install, and service custom home AV systems, no third-party labor."
  />

  <ProjectsGrid
    projects={projects}
    overline="Recent Projects"
    heading="Home Theater Installs Near Alamo Heights"
  />

  <TestimonialsSection featured={featured} />

  <!-- Why KZ -->
  <section class="section bg-charcoal">
    <div class="container-main">
      <p class="overline mb-3">Why KZ Audio & Video</p>
      <h2 class="font-display text-h2 text-warm-white mb-10">
        Alamo Heights Homes Deserve a System Built for the Room
      </h2>
      <p class="text-body text-stone mb-10 max-w-3xl">
        Alamo Heights is one of San Antonio's most established enclaves: a mix of mid-century homes, renovated estates, and newer builds along Broadway, Ogden Avenue, and the streets off Olmos Creek. The architecture varies dramatically, which means every AV install is different. We've worked in tight historic spaces and wide-open modern floor plans. We design around the room, not around a standard package.
      </p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {[
          {
            title: 'Historic Homes, Modern Systems',
            desc: 'Many Alamo Heights homes are 50–80 years old with original construction. We know how to run wire cleanly through finished walls, minimize drywall impact, and make a 1950s home look like it was built for surround sound.',
          },
          {
            title: '25+ Years in San Antonio Audio',
            desc: "Kelly has been doing this since 1999. We've been in Alamo Heights homes and know the neighborhood. You're not getting a national chain, you're getting the people who live and work in San Antonio.",
          },
          {
            title: 'Free In-Home Consultation',
            desc: 'We come to your home in Alamo Heights, look at the room, and give you a real quote. No charge, no obligation, no sales pressure.',
          },
        ].map(({ title, desc }) => (
          <div class="flex flex-col gap-3">
            <h3 class="font-sans font-semibold text-h4 text-warm-white">{title}</h3>
            <p class="text-body text-stone">{desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CTASection
    heading="Ready to Get Started in Alamo Heights?"
    body="Book a free, no-pressure consultation. We'll come to your home in Alamo Heights and design a system around your space and how you actually use it."
    ctaLabel="Book a Free Consultation"
    ctaHref="/contact-kz-audio-video-san-antonio-tx/"
    secondaryLabel="Call (210) 981-4098"
    secondaryHref="tel:2109814098"
  />

</BaseLayout>
