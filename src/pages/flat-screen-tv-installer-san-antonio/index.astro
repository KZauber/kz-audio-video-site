const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How much does it cost to have a flat screen TV installed in San Antonio?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Flat screen TV installation in San Antonio runs $150–$450 depending on wall type, mount complexity, cord concealment, and whether audio is being connected. A standard drywall install with in-wall cord concealment is $175–$275. Fireplace installs with stone or brick are $300–$450. Samsung Frame TV installs with the one-connect box routed in-wall are $250–$400. We give you a firm price before we start."
      }
    },
    {
      "@type": "Question",
      "name": "What does a professional TV installer do that I can't do myself?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Three things most homeowners can't easily do: (1) Run cables inside the wall cleanly, including adding a code-compliant in-wall power outlet behind the TV. (2) Find studs accurately in stone, tile, and unusual wall materials and know the load rating of the hardware for the TV's weight. (3) Connect and calibrate audio — soundbar, surround sound, or Sonos — so everything works from one remote and sounds right. The TV on the wall is the easy part. The wiring, the audio, and the programming are where most DIY installs fall short."
      }
    },
    {
      "@type": "Question",
      "name": "Do you hide the cords when installing a TV?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes — cord concealment is part of every install we do. On drywall we route cables inside the wall with an in-wall power bridge (code-compliant, no extension cord hacks). On stone, brick, or tile we use low-profile surface raceways matched to the wall color. We never leave wires hanging down the wall. Every install looks finished."
      }
    },
    {
      "@type": "Question",
      "name": "Can you install a flat screen TV above a fireplace?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Above-fireplace installs require a full-motion or tilting mount — a flat fixed mount is the wrong tool here, because the screen ends up too high and at the wrong angle. We set the viewing angle so the screen tilts toward your seated position, assess heat clearance from the firebox, and route cables through the wall or the mantel cavity. We do a lot of these in San Antonio homes with stone surrounds."
      }
    },
    {
      "@type": "Question",
      "name": "Do you install outdoor flat screen TVs on patios?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Outdoor TV installation on covered patios, pool decks, and outdoor kitchens is a standard service. San Antonio's climate — 100+ degree summers, UV exposure, humidity — means indoor TVs fail outdoors within one to two seasons. We install outdoor-rated TVs (Séura, SunBrite, Samsung Terrace) with proper mounting hardware and weatherproof cable routing."
      }
    },
    {
      "@type": "Question",
      "name": "Do you install Samsung Frame TVs?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. The Frame TV only looks right when it's installed correctly — flush to the wall with zero visible cables, and the one-connect box routed inside the wall or into a media closet. We are a Samsung Frame TV specialist. If the one-connect cable is hanging down the wall, the install is not finished."
      }
    },
    {
      "@type": "Question",
      "name": "How high should a flat screen TV be mounted?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The center of the screen should sit at seated eye level — typically 42–48 inches from the floor for a standard sofa. This is lower than most homeowners expect. Mounting too high (at standing eye level) causes neck strain and reduces picture quality. Above-fireplace installs are the exception where a tilting mount is required to compensate for the elevated position."
      }
    }
  ]
};

