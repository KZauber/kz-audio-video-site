<BaseLayout
  title="Flat Screen TV Installer San Antonio TX | KZ Audio & Video"
  description="Professional flat screen TV installation in San Antonio TX. Zero visible wires, correct mount height, audio connected. Samsung Frame TV specialist. In-home since 2001. Call (210) 981-4098."
  schema={[schema, breadcrumb, faqSchema]}
>

  <!-- Hero -->
  <section class="relative min-h-[60vh] flex items-center bg-charcoal overflow-hidden">
    <div class="absolute inset-0">
      <img
        src="/images/projects/samsung-frame-tv-marble-fireplace-san-antonio/samsung-frame-tv-san-antonio.jpg"
        alt="Professional flat screen TV installation San Antonio TX"
        class="w-full h-full object-cover opacity-30"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-charcoal via-charcoal/80 to-transparent"></div>
    </div>
    <div class="relative container-main py-20">
      <p class="overline mb-4">Flat Screen TV Installation · San Antonio · Since 2001</p>
      <h1 class="font-display text-h1 text-warm-white mb-6 max-w-2xl">
        Flat Screen TV Installer in San Antonio TX
      </h1>
      <p class="text-body-lg text-stone mb-10 max-w-xl">
        Zero visible wires. Correct height. Audio connected and working. KZ Audio &amp; Video has been installing flat screen TVs in San Antonio homes since 2001. We do it clean — one visit, done right, no callbacks.
      </p>
      <div class="flex flex-wrap gap-4">
        <a href="/contact-kz-audio-video-san-antonio-tx/" class="btn-primary gold-shimmer">
          Book a Free Consultation
        </a>
        <a href="tel:2109814098" class="btn-secondary">
          Call (210) 981-4098
        </a>
      </div>
    </div>
  </section>

  <TrustBar />

  <!-- What sets us apart -->
  <section class="section bg-slate-surface">
    <div class="container-main">
      <p class="overline mb-3">The KZ Standard</p>
      <h2 class="font-display text-h2 text-warm-white mb-6 max-w-2xl">
        This Is What a Finished Install Looks Like
      </h2>
      <p class="text-body-lg text-stone mb-12 max-w-2xl">
        A TV on the wall is not an install — it's the beginning of one. The install is finished when the wires are inside the wall, the mount angle is right, the sound is connected, and you're holding one remote that controls everything.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-12">
        {[
          {
            num: "01",
            title: "Zero Visible Wires",
            desc: "Cables routed inside the wall on drywall. Surface raceways matched to the wall finish on stone, brick, and tile. No wires hanging down the wall — ever.",
          },
          {
            num: "02",
            title: "Correct Mount Height",
            desc: "The center of your screen at seated eye level — 42–48\" from the floor for a standard sofa. Not at standing height. Not at the fireplace mantel. Where it belongs.",
          },
          {
            num: "03",
            title: "Right Mount for the Wall",
            desc: "Fixed, tilting, or full-motion mounts selected and rated for your wall type and TV weight. Fireplace installs get full-motion mounts. Concrete and brick get the right anchors.",
          },
          {
            num: "04",
            title: "Audio Connected & Calibrated",
            desc: "Soundbar, Sonos Arc, or full surround sound connected via HDMI eARC and calibrated in the same visit. You should be able to turn one thing on and have it all work.",
          },
          {
            num: "05",
            title: "Samsung Frame TV Specialist",
            desc: "The Frame TV looks like art when installed correctly. The one-connect box routes in-wall or to a media closet. If the cable is hanging down the wall, the install isn't done.",
          },
          {
            num: "06",
            title: "One Visit, Firm Price",
            desc: "We quote the full job before we start — mount, concealment, audio, programming. No hourly surprises. No 'that's extra.' One price, one visit, done.",
          },
        ].map(({ num, title, desc }) => (
          <div class="card p-7 flex flex-col gap-3">
            <span class="font-display text-gold-primary text-2xl">{num}</span>
            <h3 class="font-sans font-semibold text-h4 text-warm-white">{title}</h3>
            <p class="text-body-sm text-stone leading-relaxed">{desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Project gallery -->
  <section class="section bg-charcoal">
    <div class="container-main">
      <p class="overline mb-3">Recent Installs</p>
      <h2 class="font-display text-h2 text-warm-white mb-4">
        What We Actually Do
      </h2>
      <p class="text-body-lg text-stone mb-12 max-w-xl">
        These are real installations in San Antonio homes. Not stock photos. Not manufacturer renders.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {installs.map(({ title, desc, img, alt }) => (
          <div class="card overflow-hidden flex flex-col">
            <div class="aspect-[4/3] overflow-hidden">
              <img
                src={img}
                alt={alt}
                class="w-full h-full object-cover hover:scale-105 transition-transform duration-500"
                loading="lazy"
              />
            </div>
            <div class="p-6 flex flex-col gap-2 flex-1">
