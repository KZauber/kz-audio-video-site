      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
          <p class="overline mb-3">Pricing</p>
          <h2 class="font-display text-h2 text-warm-white mb-6">
            What Flat Screen TV Installation Costs in San Antonio
          </h2>
          <p class="text-body-lg text-stone mb-8">
            We give you a firm price before we start. No hourly rates, no scope creep. Every quote includes the mount, cord concealment, and audio connection.
          </p>
          <a href="/tv-mounting-cost-san-antonio/" class="btn-primary gold-shimmer">
            Use the Free Cost Calculator →
          </a>
        </div>
        <div class="flex flex-col gap-4">
          {[
            { label: "Standard drywall wall mount + cord concealment", price: "$175–$275" },
            { label: "Fireplace / above-mantel (stone or brick)", price: "$300–$450" },
            { label: "Samsung Frame TV (in-wall one-connect routing)", price: "$250–$400" },
            { label: "Outdoor TV on covered patio", price: "$275–$450" },
            { label: "TV + soundbar / Sonos Arc connected", price: "$275–$475" },
            { label: "TV + full surround sound connected + calibrated", price: "$350–$600" },
          ].map(({ label, price }) => (
            <div class="card p-5 flex items-center justify-between gap-4">
              <span class="text-body-sm text-stone">{label}</span>
              <span class="font-sans font-semibold text-warm-white whitespace-nowrap">{price}</span>
            </div>
          ))}
          <p class="text-body-sm text-stone mt-2">
            * Prices are typical ranges for San Antonio installations. Firm quotes provided in-home after assessing wall type, TV size, and audio scope.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Service area -->
  <section class="section bg-charcoal">
    <div class="container-main text-center max-w-3xl mx-auto">
      <p class="overline mb-3">Service Area</p>
      <h2 class="font-display text-h2 text-warm-white mb-6">
        We Install Flat Screen TVs Across San Antonio and the Hill Country
      </h2>
      <p class="text-body-lg text-stone mb-8">
        San Antonio · Boerne · Bulverde · Stone Oak · Helotes · Timberwood Park · Canyon Lake · New Braunfels · Schertz · Converse · Live Oak · Universal City and the surrounding Texas Hill Country.
      </p>
      <a href="/contact-kz-audio-video-san-antonio-tx/" class="btn-primary gold-shimmer">
        Book a Free In-Home Consultation
      </a>
    </div>
  </section>

  <TestimonialsSection featured={featured} />

  <FAQAccordion
    heading="Flat Screen TV Installation — Frequently Asked Questions"
    faqs={faqs}
  />

  <CTASection
    heading="Ready to Get Your TV on the Wall?"
    body="We'll confirm the mount type, cord concealment method, and audio connection — then give you a firm quote. Free in-home consultation. No surprises."
    ctaLabel="Book a Free Consultation"
    ctaHref="/contact-kz-audio-video-san-antonio-tx/"
    secondaryLabel="Call (210) 981-4098"
    secondaryHref="tel:2109814098"
  />

</BaseLayout>
