const installs = [
  {
    title: "Samsung Frame TV on Marble",
    desc: "Flush-mounted with zero visible cables. The one-connect box routes in-wall. Looks like art on the wall — because that's the point.",
    img: "/images/projects/samsung-frame-tv-marble-fireplace-san-antonio/samsung-frame-tv-san-antonio.jpg",
    alt: "Samsung Frame TV mounted flush on marble wall San Antonio TX",
