const featured = {
  name: 'San Antonio Homeowner',
  location: 'San Antonio, TX',
  service: 'TV Installation Client',
  quote: "Kelly and crew did an amazing job installing our TV above the fireplace. Clean installation, no visible wires, and he set up our surround sound at the same time. Worth every penny to have it done right.",
